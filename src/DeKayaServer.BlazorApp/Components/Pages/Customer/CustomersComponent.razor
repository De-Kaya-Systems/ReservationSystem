@page "/customers"
@using DeKayaServer.BlazorApp.Components.Pages.Customer.CreateCustomer
@using DeKayaServer.BlazorApp.Components.Pages.Customer.DeleteCustomer
@using DeKayaServer.BlazorApp.Components.Pages.Customer.DetailCustomer
@using DeKayaServer.BlazorApp.Components.Pages.Customer.UpdateCustomer
@using DeKayaServer.Contracts.Customers
@using Microsoft.AspNetCore.Components.QuickGrid
@inherits UserContextComponent
@inject ICustomerService customerService
@rendermode InteractiveServer

<PageTitle>De-Kaya Systems | @PageTitleConstans.CustomersPage</PageTitle>

<PageHeader Title="Müşteri Yönetimi"
            Icon="bi bi-person-vcard"
            Description="Bu sayfada müşteri işlemlerini yönetebilirsin." />

@if ( !string.IsNullOrWhiteSpace( errorMessage ) )
{
    <div class="alert alert-danger mt-3 mb-0">
        @errorMessage
    </div>
}

<DeKayaQuickGrid Title="Müşteri Listesi"
                 ShowTitle="true"
                 ShowSearchResultCount="true"
                 TotalItemCount="@totalItemCount"
                 ShowPageSizeSelector="true"
                 PageSize="@pageSize"
                 PageSizeChanged="OnPageSizeChanged">

    <HeaderActions>
        @if ( CurrentUser.HasPermission( "customer:create" ) )
        {
            <button type="button"
                    class="btn btn-outline-success btn-sm"
                    @onclick="ShowCreateCustomerDialog">
                <i class="bi bi-plus-circle"></i>
                <span>Ekle</span>
            </button>
        }
    </HeaderActions>

    <QuickGridContent>
        <div class="p-3 border-bottom bg-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label small text-body-secondary">Müşteri adı</label>
                    <input class="form-control form-control-sm"
                           placeholder="Müşteri ara..."
                           @bind="customerNameFilter"
                           @bind:event="oninput" />
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label small text-body-secondary">Telefon numarası</label>
                    <input class="form-control form-control-sm"
                           placeholder="Telefon ara..."
                           @bind="phoneNumberFilter"
                           @bind:event="oninput" />
                </div>

                <div class="col-12 col-lg-4 d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            @onclick="ApplyFiltersAsync">
                        Filtrele
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="ClearFiltersAsync">
                        Temizle
                    </button>
                </div>
            </div>
        </div>

        <QuickGrid TGridItem="CustomerListItemDto"
                   @ref="grid"
                   ItemsProvider="@LoadCustomersAsync"
                   Pagination="pagination"
                   Class="table table-striped table-hover table-responsive mb-0 align-middle">

            <PropertyColumn Property="@(c => c.FullName)"
                            Title="Adı Soyadı" />

            <TemplateColumn Title="Durum" Context="c">
                <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary") p-2">
                    <i class="bi @(c.IsActive ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                    @(c.IsActive ? "Aktif" : "Pasif")
                </span>
            </TemplateColumn>

            <PropertyColumn Property="@(c => c.PhoneNumber)"
                            Title="Telefon numarası" />

            <PropertyColumn Property="@(c => c.Email)"
                            Title="E-Mail" />

            <PropertyColumn Property="@(c => c.City)"
                            Title="İl" />

            <PropertyColumn Property="@(c => c.District)"
                            Title="İlçe" />

            <PropertyColumn Property="@(c => c.CreatedFullName)"
                            Title="Oluşturan" />

            <TemplateColumn Title="İşlemler" Context="c">
                <div class="d-flex gap-2 py-1 justify-content-start">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="() => ShowCustomerDetailDialog( c )">
                        <i class="bi bi-search"></i>
                        <span>Detay</span>
                    </button>

                    @if ( CurrentUser.HasPermission( "customer:edit" ) )
                    {
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                @onclick="() => ShowUpdateCustomerDialog( c )">
                            <i class="bi bi-pen"></i>
                            <span>Güncelle</span>
                        </button>
                    }

                    @if ( CurrentUser.HasPermission( "customer:delete" ) )
                    {
                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                @onclick="() => ShowDeleteCustomerDialog( c )">
                            <i class="bi bi-trash3"></i>
                            <span>Sil</span>
                        </button>
                    }
                </div>
            </TemplateColumn>
        </QuickGrid>

        <div class="p-2">
            <Paginator State="pagination" />
        </div>
    </QuickGridContent>
</DeKayaQuickGrid>

<CustomerDetailsDialog @ref="customerDetailsDialog"
                       CustomerId="@selectedCustomerId" />

<CreateCustomerDialog @ref="createCustomerDialog"
                      CustomerAdded="ReloadFromFirstPageAsync" />

<UpdateCustomerDialog @ref="updateCustomerDialog"
                      CustomerId="@selectedCustomerId"
                      CustomerUpdated="ReloadFromFirstPageAsync" />

<DeleteCustomerDialog @ref="deleteCustomerDialog"
                      CustomerId="@selectedCustomerId"
                      FullName="@selectedFullName"
                      CustomerDeleted="ReloadFromFirstPageAsync" />

@code {
    private QuickGrid<CustomerListItemDto>? grid;

    private int totalItemCount;
    private int pageSize = 25;
    private string? errorMessage;
    private PaginationState pagination = new() { ItemsPerPage = 25 };

    private string customerNameFilter = string.Empty;
    private string phoneNumberFilter = string.Empty;

    private CreateCustomerDialog? createCustomerDialog;
    private UpdateCustomerDialog? updateCustomerDialog;
    private DeleteCustomerDialog? deleteCustomerDialog;
    private CustomerDetailsDialog? customerDetailsDialog;

    private Guid selectedCustomerId;
    private string? selectedFullName;

    private async ValueTask<GridItemsProviderResult<CustomerListItemDto>> LoadCustomersAsync(
        GridItemsProviderRequest<CustomerListItemDto> request )
    {
        errorMessage = null;

        var resolvedPageSize = request.Count ?? pageSize;
        var pageIndex = resolvedPageSize <= 0
            ? 0
            : request.StartIndex / resolvedPageSize;

        var result = await customerService.GetListAsync(
            customerName: customerNameFilter,
            phoneNumber: phoneNumberFilter,
            pageIndex: pageIndex,
            pageSize: resolvedPageSize,
            cancellationToken: CancellationToken.None );

        if ( !result.IsSuccessful || result.Data is null )
        {
            totalItemCount = 0;
            errorMessage = result.ErrorMessages?.FirstOrDefault()
                ?? "Müşteriler getirilemedi.";

            return GridItemsProviderResult.From(
                items: Array.Empty<CustomerListItemDto>(),
                totalItemCount: 0 );
        }

        totalItemCount = result.Data.TotalCount;

        return GridItemsProviderResult.From(
            items: result.Data.Items,
            totalItemCount: result.Data.TotalCount );
    }

    private async Task ApplyFiltersAsync()
    {
        await pagination.SetCurrentPageIndexAsync( 0 );
        await RefreshGridAsync();
    }

    private async Task ClearFiltersAsync()
    {
        customerNameFilter = string.Empty;
        phoneNumberFilter = string.Empty;

        await ApplyFiltersAsync();
    }

    private async Task OnPageSizeChanged( int value )
    {
        pageSize = value;
        pagination.ItemsPerPage = value;

        await pagination.SetCurrentPageIndexAsync( 0 );
        await RefreshGridAsync();
    }

    private async Task ReloadFromFirstPageAsync()
    {
        await pagination.SetCurrentPageIndexAsync( 0 );
        await RefreshGridAsync();
    }

    private async Task RefreshGridAsync()
    {
        if ( grid is not null )
        {
            await grid.RefreshDataAsync();
        }

        await InvokeAsync( StateHasChanged );
    }

    private async Task ShowCustomerDetailDialog( CustomerListItemDto customer )
    {
        selectedCustomerId = customer.Id;

        await InvokeAsync( StateHasChanged );
        await Task.Yield();

        if ( customerDetailsDialog is null )
        {
            return;
        }

        await customerDetailsDialog.ShowAsync();
    }

    private async Task ShowCreateCustomerDialog()
    {
        if ( createCustomerDialog is null )
        {
            return;
        }

        await createCustomerDialog.ShowAsync();
    }

    private async Task ShowUpdateCustomerDialog( CustomerListItemDto customer )
    {
        selectedCustomerId = customer.Id;

        await InvokeAsync( StateHasChanged );
        await Task.Yield();

        if ( updateCustomerDialog is null )
        {
            return;
        }

        await updateCustomerDialog.ShowAsync();
    }

    private async Task ShowDeleteCustomerDialog( CustomerListItemDto customer )
    {
        selectedCustomerId = customer.Id;
        selectedFullName = customer.FullName;

        await InvokeAsync( StateHasChanged );
        await Task.Yield();

        if ( deleteCustomerDialog is null )
        {
            return;
        }

        await deleteCustomerDialog.ShowAsync();
    }
}
