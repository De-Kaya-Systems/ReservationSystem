@using DeKayaServer.BlazorApp.Components.Common.Dialog
@using DeKayaServer.BlazorApp.Models
@using DeKayaServer.Contracts.CustomerAccount
@using DeKayaServer.Contracts.PaymentTypes
@inject ICustomerService CustomerService
@inject IPaymentTypeService PaymentTypeService
@inject IApiResultPresenter ApiResultPresenter
@inject ToastService ToastService
@rendermode InteractiveServer

<Dialog @ref="dialog"
        Title="Ödeme Al">
    <ChildContent>
        @if ( isLoading )
        {
            <IsLoading Message="Ödeme bilgileri yükleniyor, lütfen bekleyin." />
        }
        else if ( PayableBalanceItems.Count == 0 )
        {
            <div class="alert alert-warning mb-0">
                Ödeme alınabilecek açık borç kalemi bulunamadı.
            </div>
        }
        else
        {
            <EditForm Model="@model" OnValidSubmit="HandleValidSubmitAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Borç kalemi</label>
                    <InputSelect class="form-select"
                                 @bind-Value="model.CustomerBalanceId"
                                 @bind-Value:after="OnBalanceChanged">
                        <option value="">Borç kalemi seçin</option>

                        @foreach ( var balance in PayableBalanceItems )
                        {
                            <option value="@balance.Id.ToString()">
                                @BuildBalanceOptionText( balance )
                            </option>
                        }
                    </InputSelect>
                </div>

                @if ( SelectedBalance is not null )
                {
                    <div class="alert alert-light border py-2 px-3 mb-3">
                        <div class="d-flex justify-content-between">
                            <span>Toplam borç</span>
                            <span class="fw-semibold">@FormatMoney( SelectedBalance.TotalAmount )</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span>Ödenen</span>
                            <span class="fw-semibold">@FormatMoney( SelectedBalance.PaidAmount )</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span>Kalan borç</span>
                            <span class="fw-bold">@FormatMoney( SelectedBalance.OutstandingAmount )</span>
                        </div>
                    </div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Ödeme tipi</label>
                        <InputSelect class="form-select" @bind-Value="model.PaymentTypeId">
                            <option value="">Ödeme tipi seçin</option>

                            @foreach ( var paymentType in PaymentTypeOptions )
                            {
                                <option value="@paymentType.Id.ToString()">
                                    @paymentType.Name
                                </option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Ödeme tarihi</label>
                        <InputDate class="form-control" @bind-Value="model.PaymentDate" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ödeme tutarı</label>
                    <div class="input-group">
                        <InputNumber class="form-control"
                                     @bind-Value="model.PaymentAmount" />
                        <span class="input-group-text">₺</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Not</label>
                    <InputTextArea class="form-control"
                                   @bind-Value="model.Notes"
                                   placeholder="Dekont no, havale açıklaması veya işlem notu" />
                    <div class="form-text">
                        Ödeme tipi sınıflandırma içindir; not alanına dekont veya referans bilgisi yazılabilir.
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-end mt-4 pt-3 border-top">
                    <button type="button"
                            class="btn btn-outline-secondary px-4 py-2 fw-semibold"
                            @onclick="HideAsync"
                            disabled="@isSubmit">
                        İptal
                    </button>

                    <button type="submit"
                            class="btn btn-outline-success px-4 py-2 fw-semibold"
                            disabled="@isSubmit">
                        Ödemeyi Kaydet
                    </button>
                </div>
            </EditForm>
        }
    </ChildContent>
</Dialog>

@code {
    private Dialog? dialog;
    private bool isLoading;
    private bool isSubmit;

    private ReceivePaymentViewModel model = new();
    private List<PaymentTypeOption> paymentTypes = [];

    [Parameter]
    public Guid CustomerId { get; set; }

    [Parameter]
    public IReadOnlyList<CustomerAccountBalanceItemDto> BalanceItems { get; set; } = [];

    [Parameter]
    public EventCallback PaymentReceived { get; set; }

    private IReadOnlyList<CustomerAccountBalanceItemDto> PayableBalanceItems
        => BalanceItems
            .Where( x => x.OutstandingAmount > 0 )
            .OrderByDescending( x => x.CreatedAt )
            .ToList();

    private IReadOnlyList<PaymentTypeOption> PaymentTypeOptions
        => paymentTypes
            .Where( x => !IsNoPay( x.Name ) )
            .OrderBy( x => x.Name )
            .ToList();

    private CustomerAccountBalanceItemDto? SelectedBalance
        => model.CustomerBalanceId.HasValue
            ? PayableBalanceItems.FirstOrDefault( x => x.Id == model.CustomerBalanceId.Value )
            : null;

    public async Task ShowAsync()
    {
        if ( dialog is null )
        {
            return;
        }

        isLoading = true;
        InitForm();

        await dialog.ShowAsync();
        await InvokeAsync( StateHasChanged );

        await LoadPaymentTypesAsync();

        if ( PayableBalanceItems.Count == 1 )
        {
            model.CustomerBalanceId = PayableBalanceItems[ 0 ].Id;
        }

        isLoading = false;
        await InvokeAsync( StateHasChanged );
    }

    public async Task HideAsync()
    {
        if ( dialog is null )
        {
            return;
        }

        await dialog.HideAsync();
    }

    private void InitForm()
    {
        model = new ReceivePaymentViewModel
        {
            PaymentDate = DateTime.Now
        };
    }

    private async Task LoadPaymentTypesAsync()
    {
        var result = await PaymentTypeService.GetAllAsync();

        if ( !result.IsSuccessful || result.Data is null )
        {
            ToastService.ShowError(
                result.ErrorMessages?.FirstOrDefault()
                ?? "Ödeme tipleri getirilemedi." );

            paymentTypes = [];
            return;
        }

        paymentTypes = result.Data
            .Where( x => x.IsActive )
            .Select( x => new PaymentTypeOption( x.Id, x.Name ) )
            .ToList();
    }

    private void OnBalanceChanged()
    {
        model.PaymentAmount = 0;
    }

    private async Task HandleValidSubmitAsync()
    {
        if ( model.CustomerBalanceId is null )
        {
            ToastService.ShowError( "Ödeme yapılacak borç kalemi seçilmelidir." );
            return;
        }

        if ( model.PaymentTypeId is null )
        {
            ToastService.ShowError( "Ödeme tipi seçilmelidir." );
            return;
        }

        if ( model.PaymentAmount <= 0 )
        {
            ToastService.ShowError( "Ödeme tutarı 0'dan büyük olmalıdır." );
            return;
        }

        if ( SelectedBalance is null )
        {
            ToastService.ShowError( "Seçilen borç kalemi bulunamadı." );
            return;
        }

        if ( model.PaymentAmount > SelectedBalance.OutstandingAmount )
        {
            ToastService.ShowError( "Ödeme tutarı kalan borçtan büyük olamaz." );
            return;
        }

        if ( string.Equals(
            PaymentTypeOptions.FirstOrDefault( x => x.Id == model.PaymentTypeId.Value )?.Name,
            "NoPay",
            StringComparison.OrdinalIgnoreCase ) )
        {
            ToastService.ShowError( "NoPay ile ödeme alınamaz." );
            return;
        }

        if ( !string.IsNullOrWhiteSpace( model.Notes ) && model.Notes.Length > 500 )
        {
            ToastService.ShowError( "Açıklama en fazla 500 karakter olabilir." );
            return;
        }

        try
        {
            isSubmit = true;

            var request = new ReceiveCustomerPaymentRequest
            {
                CustomerBalanceId = model.CustomerBalanceId.Value,
                PaymentTypeId = model.PaymentTypeId.Value,
                PaymentAmount = model.PaymentAmount,
                PaymentDate = model.PaymentDate,
                Notes = string.IsNullOrWhiteSpace( model.Notes ) ? null : model.Notes.Trim()
            };

            var result = await CustomerService.ReceivePaymentAsync( CustomerId, request );

            ApiResultPresenter.Present(
                result,
                new ApiPresentationOptions { ShowSuccess = true } );

            if ( !result.IsSuccessful )
            {
                return;
            }

            await HideAsync();

            if ( PaymentReceived.HasDelegate )
            {
                await PaymentReceived.InvokeAsync();
            }
        }
        finally
        {
            isSubmit = false;
        }
    }

    private static string BuildBalanceOptionText( CustomerAccountBalanceItemDto balance )
    {
        var description = string.IsNullOrWhiteSpace( balance.Description )
            ? FormatSourceType( balance.SourceType )
            : balance.Description;

        return $"{description} - Kalan: {FormatMoney( balance.OutstandingAmount )}";
    }

    private static string FormatMoney( decimal value )
        => value.ToString( "N2" ) + " ₺";

    private static string FormatSourceType( string value )
        => value switch
        {
            "Reservation" => "Rezervasyon",
            "Product" => "Ürün",
            "Service" => "Hizmet",
            _ => value
        };

    private static bool IsNoPay( string? name )
        => string.Equals( name?.Trim(), "NoPay", StringComparison.OrdinalIgnoreCase );

    private sealed class ReceivePaymentViewModel
    {
        public Guid? CustomerBalanceId { get; set; }
        public Guid? PaymentTypeId { get; set; }
        public decimal PaymentAmount { get; set; }
        public DateTime PaymentDate { get; set; } = DateTime.Now;
        public string? Notes { get; set; }
    }

    private sealed record PaymentTypeOption( Guid Id, string Name );
}
