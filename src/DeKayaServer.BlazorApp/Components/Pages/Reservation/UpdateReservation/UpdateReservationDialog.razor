@using DeKayaServer.BlazorApp.Components.Common.Dialog
@using DeKayaServer.BlazorApp.Models
@using DeKayaServer.Contracts.Reservations
@using DeKayaServer.Contracts.Reservations.Enum
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using TS.Result
@inject IReservationService reservationService
@inject ICustomerService customerService
@inject ICoolingRoomService coolingRoomService
@inject IPaymentTypeService paymentTypeService
@inject IApiResultPresenter apiResultPresenter
@inject ToastService toastService
@rendermode InteractiveServer

<div class="update-reservation-dialog">
    <Dialog @ref="dialog"
            Title="Rezervasyon Güncelle">
        <ChildContent>
            @if ( isLoading )
            {
                <IsLoading Message="Rezervasyon bilgileri yükleniyor, lütfen bekleyin." />
            }
            else
            {
                <EditForm EditContext="@editContext"
                          OnValidSubmit="HandleValidSubmit"
                          OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    @if ( !string.IsNullOrWhiteSpace( dialogResultMessage ) )
                    {
                        <div class="alert @dialogResultCssClass py-2 px-3 mb-3">
                            @dialogResultMessage
                        </div>
                    }

                    <fieldset disabled="@IsReservationEnded">
                        @if ( IsReservationEnded )
                        {
                            <div class="alert alert-warning py-2 px-3 mb-3">
                                Bu rezervasyonun süresi dolduğu için yalnızca görüntülenebilir.
                            </div>
                        }

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-3">
                                <label class="form-label">Başlangıç tarihi</label>
                                <InputDate class="form-control"
                                           @bind-Value="model.DeliveryDate"
                                           @bind-Value:after="OnDatesChanged"
                                           disabled="@IsDeliveryDateTimeInPast" />
                                <ValidationMessage For="@(() => model.DeliveryDate)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">Başlangıç saati</label>
                                <InputText class="form-control"
                                           type="time"
                                           @bind-Value="model.DeliveryTime"
                                           @bind-Value:after="OnPricingInputChanged"
                                           disabled="@IsDeliveryDateTimeInPast" />
                                <ValidationMessage For="@(() => model.DeliveryTime)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">Rezervasyon bitiş tarihi</label>
                                <InputDate class="form-control"
                                           @bind-Value="model.PickUpDate"
                                           @bind-Value:after="OnDatesChanged"
                                           @attributes="PickUpDateAttributes" />
                                <ValidationMessage For="@(() => model.PickUpDate)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">Rezervasyon bitiş saati</label>
                                <InputText class="form-control"
                                           type="time"
                                           @bind-Value="model.PickUpTime"
                                           @bind-Value:after="OnPricingInputChanged" />
                                <ValidationMessage For="@(() => model.PickUpTime)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <InputSelect class="form-select"
                                                 @bind-Value="model.Status">
                                        <option value="@ReservationOperationStatusDto.Scheduled"
                                                disabled="@(model.Status == ReservationOperationStatusDto.DeliveredToCustomer)">
                                            Rezerve edildi
                                        </option>
                                        <option value="@ReservationOperationStatusDto.DeliveredToCustomer">
                                            Müşteriye teslim edildi
                                        </option>
                                    </InputSelect>
                                    <label>Operasyon durumu</label>
                                </div>
                                <div class="small text-body-secondary mt-1">
                                    Oda müşteriye verildiyse durumu müşteriye teslim edildi olarak güncelleyin.
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <div class="position-relative">
                                    <div class="form-floating">
                                        <input class="form-control"
                                               value="@customerSearchTerm"
                                               @oninput="OnCustomerSearchInput"
                                               placeholder="Müşteri ara" />
                                        <label>Müşteri ara</label>
                                    </div>
                                    <ValidationMessage For="@(() => model.CustomerId)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />

                                    @if ( ShowCustomerSuggestions )
                                    {
                                        <div class="list-group position-absolute w-100 mt-1 shadow-sm" style="z-index: 1050;">
                                            @foreach ( var customer in FilteredCustomers )
                                            {
                                                <button type="button"
                                                        class="list-group-item list-group-item-action"
                                                        @onclick="() => SelectCustomer( customer )">
                                                    @customer.CustomerDisplay
                                                </button>
                                            }

                                            @if ( !FilteredCustomers.Any() )
                                            {
                                                <div class="list-group-item text-body-secondary">
                                                    Sonuç bulunamadı
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <InputSelect class="form-select"
                                                 @bind-Value="model.CoolingRoomId"
                                                 @bind-Value:after="OnCoolingRoomChanged"
                                                 disabled="@(!DatesSelected || IsDateRangeInvalid || isLoadingRooms )">
                                        <option value="">Soğuk oda seçin</option>
                                        @foreach ( var room in rooms )
                                        {
                                            <option value="@room.Id.ToString()">@room.Name</option>
                                        }
                                    </InputSelect>
                                    <label>Soğuk oda</label>
                                </div>
                                <ValidationMessage For="@(() => model.CoolingRoomId)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />

                                @if ( isLoadingRooms )
                                {
                                    <div class="small text-body-secondary mt-1">Uygun odalar yükleniyor...</div>
                                }
                                else if ( !string.IsNullOrWhiteSpace( roomsInfoMessage ) )
                                {
                                    <div class="small text-body-secondary mt-1">@roomsInfoMessage</div>
                                }
                            </div>
                        </div>

                        @if ( SelectedRoom is not null )
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Standart günlük fiyat</label>
                                    <div class="input-group">
                                        <input class="form-control"
                                               value="@SelectedRoom.DailyPrice.ToString( "N2" )"
                                               disabled />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label">Uygulanacak günlük fiyat</label>
                                    <div class="input-group">
                                        <InputNumber class="form-control"
                                                     @bind-Value="model.AppliedDailyPrice"
                                                     @bind-Value:after="OnPricingInputChanged" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                    <ValidationMessage For="@(() => model.AppliedDailyPrice)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                                </div>
                            </div>

                            @if ( HasPriceOverride )
                            {
                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating">
                                            <InputText class="form-control"
                                                       @bind-Value="model.PriceOverrideReason"
                                                       @bind-Value:after="ValidatePriceOverrideReason"
                                                       placeholder="Fiyat değişikliği sebebi" />
                                            <label>Fiyat değişikliği sebebi</label>
                                        </div>
                                        <ValidationMessage For="@(() => model.PriceOverrideReason)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="form-floating">
                                            <InputText class="form-control"
                                                       @bind-Value="model.PriceOverrideNote"
                                                       placeholder="Fiyat değişikliği notu" />
                                            <label>Fiyat değişikliği notu</label>
                                        </div>
                                        <ValidationMessage For="@(() => model.PriceOverrideNote)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                                    </div>
                                </div>
                            }
                        }

                        <div class="mb-3">
                            <div class="form-floating">
                                <InputText class="form-control"
                                           @bind-Value="model.DeliveryLocation"
                                           placeholder="Teslimat konumu" />
                                <label>Teslimat konumu girin</label>
                            </div>
                            <ValidationMessage For="@(() => model.DeliveryLocation)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="paymentReceivedSwitchUpdate"
                                           checked="@paymentReceived"
                                           @onchange="OnPaymentReceivedChanged" />
                                    <label class="form-check-label" for="paymentReceivedSwitchUpdate">Bu güncellemede ödeme alındı mı?</label>
                                </div>

                                @if ( paymentReceived )
                                {
                                    <div class="form-floating">
                                        <InputSelect class="form-select"
                                                     @bind-Value="model.PaymentTypeId">
                                            <option value="">Ödeme tipi seçin</option>
                                            @foreach ( var paymentType in PaymentTypeOptions )
                                            {
                                                <option value="@paymentType.Id.ToString()">@paymentType.Name</option>
                                            }
                                        </InputSelect>
                                        <label>Ödeme tipi</label>
                                    </div>
                                    <ValidationMessage For="@(() => model.PaymentTypeId)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                                }
                                else
                                {
                                    <div class="small text-body-secondary">
                                        Ödeme alınmadı.
                                    </div>
                                }
                            </div>

                            @if ( paymentReceived )
                            {
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Bu güncellemede alınan ödemeyi girin.</label>
                                    <div class="input-group">
                                        <InputNumber class="form-control"
                                                     @bind-Value="model.PaidAtReservation"
                                                     @bind-Value:after="OnPricingInputChanged"
                                                     disabled="@(!model.PaymentTypeId.HasValue)"
                                                     placeholder="0" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                    <ValidationMessage For="@(() => model.PaidAtReservation)" class="fw-light fs-6 my-1 py-2 alert alert-danger" />
                                </div>
                            }
                        </div>

                        @if ( ComputedReservationTotalAmount is decimal totalReservationAmount )
                        {
                            <div class="alert alert-info py-2 px-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold">Toplam rezervasyon bedeli</span>
                                    <span class="fs-5 fw-bold">@totalReservationAmount.ToString( "N2" ) ₺</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span>Daha önce alınan ödeme</span>
                                    <span class="fw-semibold">@existingPaidAtReservation.ToString( "N2" ) ₺</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span>Bu güncellemede alınan ödeme</span>
                                    <span class="fw-semibold">@CurrentUpdatePaidAmount.ToString( "N2" ) ₺</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span>Toplam alınan ödeme</span>
                                    <span class="fw-semibold">@TotalPaidAtReservation.ToString( "N2" ) ₺</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span>Kalan borç</span>
                                    <span class="fw-bold">@Math.Max( totalReservationAmount - TotalPaidAtReservation, 0 ).ToString( "N2" ) ₺</span>
                                </div>
                            </div>
                        }

                        <div class="mb-4">
                            <div class="form-floating">
                                <InputTextArea class="form-control"
                                               @bind-Value="model.Note"
                                               placeholder="Not (opsiyonel)" />
                                <label>Not</label>
                            </div>
                        </div>
                    </fieldset>

                    <div class="d-flex gap-3 justify-content-end mt-4 pt-3 border-top">
                        <button type="button"
                                class="btn btn-outline-secondary px-4 py-2 fw-semibold"
                                @onclick="HideAsync"
                                disabled="@isSubmit">
                            @( operationCompleted ? "Kapat" : "İptal" )
                        </button>

                        <button type="submit"
                                class="btn btn-primary px-4 py-2 fw-semibold shadow-sm"
                                disabled="@(SubmitDisabled || IsReservationEnded || operationCompleted)">
                            Güncelle
                        </button>
                    </div>
                </EditForm>
            }
        </ChildContent>
    </Dialog>
</div>

@code {
    private const string SelectDatesMessage = "Önce rezervasyon başlangıç ve bitiş tarihlerini seçin.";
    private const string DateRangeInvalidMessage = "Rezervasyon başlangıç tarihi, bitiş tarihinden önce olamaz.";
    private const string DatesMissingMessage = "Tarihler eksik.";

    private Dialog? dialog;
    private bool isSubmit;
    private bool isLoading;
    private bool isLoadingRooms;
    private string? roomsInfoMessage;

    private UpdateReservationViewModel model = new();
    private EditContext editContext = default!;
    private ValidationMessageStore validationMessageStore = default!;
    private bool submitAttempted;

    private List<CustomerOption> customers = [];
    private List<CoolingRoomOption> rooms = [];
    private List<PaymentTypeOption> paymentTypes = [];

    private string customerSearchTerm = string.Empty;
    private bool showCustomerSuggestions;
    private bool paymentReceived;
    private Guid? noPayPaymentTypeId;
    private bool hasPaidAmountExceedsTotalError;
    private bool hasPriceOverrideReasonError;
    private decimal existingPaidAtReservation;
    private string? dialogResultMessage;
    private string dialogResultCssClass = "alert-info";
    private bool operationCompleted;

    private bool SubmitDisabled =>
        isSubmit
        || isLoading
        || ReservationId is null
        || hasPaidAmountExceedsTotalError
        || hasPriceOverrideReasonError
        || ( submitAttempted && editContext.GetValidationMessages().Any() );

    private bool ShowCustomerSuggestions
        => showCustomerSuggestions && !string.IsNullOrWhiteSpace( customerSearchTerm );

    private decimal? ComputedReservationTotalAmount
        => TryGetTotalReservationAmount( out var totalReservationAmount ) ? totalReservationAmount : null;

    private CoolingRoomOption? SelectedRoom
        => model.CoolingRoomId is null
            ? null
            : rooms.FirstOrDefault( x => x.Id == model.CoolingRoomId.Value );

    private bool HasPriceOverride
        => SelectedRoom is not null
           && model.AppliedDailyPrice > 0
           && model.AppliedDailyPrice != SelectedRoom.DailyPrice;

    private decimal CurrentUpdatePaidAmount
        => paymentReceived ? model.PaidAtReservation : 0;

    private decimal TotalPaidAtReservation
        => existingPaidAtReservation + CurrentUpdatePaidAmount;

    private bool DatesSelected
        => model.DeliveryDate.HasValue && model.PickUpDate.HasValue;

    private bool IsDateRangeInvalid
        => model.DeliveryDate.HasValue
           && model.PickUpDate.HasValue
           && model.PickUpDate.Value < model.DeliveryDate.Value;

    private bool IsReservationEnded
        => model.PickUpDate.HasValue
           && ( TimeOnly.TryParse( model.PickUpTime, out var pickUpTime )
                ? model.PickUpDate.Value.ToDateTime( pickUpTime ) <= DateTime.Now
                : model.PickUpDate.Value < DateOnly.FromDateTime( DateTime.Now ) );

    private bool IsDeliveryDateTimeInPast
        => model.DeliveryDate.HasValue
           && TimeOnly.TryParse( model.DeliveryTime, out var deliveryTime )
           && model.DeliveryDate.Value.ToDateTime( deliveryTime ) < DateTime.Now;

    private IReadOnlyDictionary<string, object> PickUpDateAttributes
        => model.DeliveryDate.HasValue
            ? new Dictionary<string, object>
            {
                [ "min" ] = model.DeliveryDate.Value.ToString( "yyyy-MM-dd" )
            }
            : new Dictionary<string, object>();

    private IReadOnlyList<CustomerOption> FilteredCustomers
        => string.IsNullOrWhiteSpace( customerSearchTerm )
            ? customers
            : customers
                .Where( c => c.CustomerDisplay.Contains( customerSearchTerm, StringComparison.OrdinalIgnoreCase ) )
                .OrderBy( c => c.CustomerDisplay )
                .Take( 8 )
                .ToList();

    private IReadOnlyList<PaymentTypeOption> PaymentTypeOptions
        => paymentTypes
            .Where( p => !IsNoPay( p.Name ) )
            .OrderBy( p => p.Name )
            .ToList();

    [Parameter] public Guid? ReservationId { get; set; }
    [Parameter] public EventCallback ReservationUpdated { get; set; }

    protected override void OnInitialized()
    {
        InitForm();
    }

    private void OnValidationStateChanged( object? sender, ValidationStateChangedEventArgs e )
        => _ = InvokeAsync( StateHasChanged );

    public async Task ShowAsync()
    {
        if ( dialog is null || ReservationId is null )
        {
            return;
        }

        submitAttempted = false;
        InitForm();
        isLoading = true;
        await InvokeAsync( StateHasChanged );

        await LoadLookupsAsync();
        await LoadReservationAsync( ReservationId.Value );
        await LoadAvailableRoomsAsync();
        ValidateReservationPricing();

        isLoading = false;
        await InvokeAsync( StateHasChanged );
        await dialog.ShowAsync();
    }

    public async Task HideAsync()
    {
        if ( dialog is null )
        {
            return;
        }

        submitAttempted = false;
        await dialog.HideAsync();
    }

    private void InitForm()
    {
        model = new UpdateReservationViewModel();
        RebindEditContext();

        customerSearchTerm = string.Empty;
        showCustomerSuggestions = false;
        paymentReceived = false;
        hasPaidAmountExceedsTotalError = false;
        hasPriceOverrideReasonError = false;
        existingPaidAtReservation = 0;
        rooms = [];
        roomsInfoMessage = SelectDatesMessage;
        dialogResultMessage = null;
        dialogResultCssClass = "alert-info";
        operationCompleted = false;
    }

    private async Task LoadReservationAsync( Guid reservationId )
    {
        var result = await reservationService.GetByIdAsync( reservationId );
        if ( !result.IsSuccessful || result.Data is null )
        {
            model = new UpdateReservationViewModel();
            RebindEditContext();
            ShowDialogError( result.ErrorMessages?.FirstOrDefault() ?? "Rezervasyon bilgileri getirilemedi." );
            return;
        }

        var reservation = result.Data;
        var customerId = TryParseGuid( reservation.CustomerId );
        var coolingRoomId = TryParseGuid( reservation.CoolingRoomId );

        model = new UpdateReservationViewModel
        {
            CustomerId = customerId,
            CoolingRoomId = coolingRoomId,
            DeliveryLocation = reservation.DeliveryLocation,
            DeliveryDate = reservation.DeliveryDate,
            DeliveryTime = TimeOnly.FromDateTime( reservation.DeliveryTime ).ToString( "HH:mm" ),
            PickUpDate = reservation.PickUpDate,
            PickUpTime = TimeOnly.FromDateTime( reservation.PickUpTime ).ToString( "HH:mm" ),
            AppliedDailyPrice = reservation.CoolingRoomDailyPrice,
            PriceOverrideReason = reservation.PriceOverrideReason,
            PriceOverrideNote = reservation.PriceOverrideNote,
            Status = ( ReservationOperationStatusDto )reservation.Status,
            PaidAtReservation = 0,
            Note = reservation.Note
        };
        RebindEditContext();

        existingPaidAtReservation = reservation.PaidAtReservation ?? 0;
        paymentReceived = false;

        if ( customerId is not null )
        {
            var selectedCustomer = customers.FirstOrDefault( c => c.Id == customerId.Value );
            customerSearchTerm = selectedCustomer is not null
                ? selectedCustomer.CustomerDisplay
                : customerId.Value.ToString();
        }

        SetNoPayPaymentTypeIfAvailable();
    }

    private void RebindEditContext()
    {
        if ( editContext is not null )
        {
            editContext.OnValidationStateChanged -= OnValidationStateChanged;
        }

        editContext = new EditContext( model );
        validationMessageStore = new ValidationMessageStore( editContext );
        editContext.OnValidationStateChanged += OnValidationStateChanged;
    }

    private void SetNoPayPaymentTypeIfAvailable()
    {
        if ( noPayPaymentTypeId is not null )
        {
            model.PaymentTypeId = noPayPaymentTypeId;
        }
    }

    private void ResetAvailableRooms( string message, bool clearSelectedRoom = true )
    {
        rooms = [];

        if ( clearSelectedRoom )
        {
            model.CoolingRoomId = null;
            ResetPricing();
        }

        roomsInfoMessage = message;
    }

    private void OnCustomerSearchInput( ChangeEventArgs e )
    {
        customerSearchTerm = e.Value?.ToString() ?? string.Empty;
        showCustomerSuggestions = true;
        OnCustomerSearchChanged();
    }

    private void OnCustomerSearchChanged()
    {
        if ( model.CustomerId is not null
             && !customers.Any( c => c.Id == model.CustomerId && c.CustomerDisplay.Equals( customerSearchTerm, StringComparison.OrdinalIgnoreCase ) ) )
        {
            model.CustomerId = null;
        }
    }

    private void SelectCustomer( CustomerOption customer )
    {
        model.CustomerId = customer.Id;
        customerSearchTerm = customer.CustomerDisplay;
        showCustomerSuggestions = false;
        _ = InvokeAsync( StateHasChanged );
    }

    private void OnPaymentReceivedChanged( ChangeEventArgs e )
    {
        paymentReceived = e.Value is bool b && b;

        if ( paymentReceived )
        {
            if ( model.PaymentTypeId == noPayPaymentTypeId )
            {
                model.PaymentTypeId = null;
            }
        }
        else
        {
            model.PaidAtReservation = 0;

            if ( existingPaidAtReservation == 0 && noPayPaymentTypeId is not null )
            {
                SetNoPayPaymentTypeIfAvailable();
            }
        }

        ValidateReservationPricing();
    }

    private async Task LoadLookupsAsync()
    {
        var customersTask = customerService.GetAllAsync();
        var paymentTypesTask = paymentTypeService.GetAllAsync();

        await Task.WhenAll( customersTask, paymentTypesTask );

        var customersResult = await customersTask;
        customers = customersResult.IsSuccessful && customersResult.Data is not null
            ? customersResult.Data
                .Select( c => new CustomerOption( c.Id, c.FullName, c.PhoneNumber ) )
                .OrderBy( c => c.CustomerDisplay )
                .ToList()
            : [];

        var paymentTypesResult = await paymentTypesTask;
        paymentTypes = paymentTypesResult.IsSuccessful && paymentTypesResult.Data is not null
            ? paymentTypesResult.Data
                .Where( p => p.IsActive )
                .Select( p => new PaymentTypeOption( p.Id, p.Name ) )
                .OrderBy( p => p.Name )
                .ToList()
            : [];

        noPayPaymentTypeId = paymentTypes.FirstOrDefault( p => IsNoPay( p.Name ) )?.Id;
    }

    private async Task LoadAvailableRoomsAsync()
    {
        roomsInfoMessage = null;

        if ( !DatesSelected )
        {
            ResetAvailableRooms( SelectDatesMessage );
            ClearDialogResultMessage();
            return;
        }

        if ( IsDateRangeInvalid )
        {
            ResetAvailableRooms( DateRangeInvalidMessage );
            ShowDialogError( DateRangeInvalidMessage );
            return;
        }

        var deliveryDate = model.DeliveryDate;
        var pickUpDate = model.PickUpDate;

        if ( deliveryDate is null || pickUpDate is null )
        {
            ResetAvailableRooms( DatesMissingMessage );
            ClearDialogResultMessage();
            return;
        }

        isLoadingRooms = true;

        try
        {
            var roomsResult = await coolingRoomService.GetAvailableAsync(
                deliveryDate.Value,
                pickUpDate.Value,
                ReservationId );

            if ( !roomsResult.IsSuccessful )
            {
                var message = roomsResult.ErrorMessages?.FirstOrDefault() ?? "Uygun odalar getirilemedi.";

                ResetAvailableRooms(
                    message: message,
                    clearSelectedRoom: false );

                ShowDialogError( message );
                return;
            }

            rooms = roomsResult.Data is not null
                ? roomsResult.Data
                    .Select( r => new CoolingRoomOption( r.Id, r.RoomName, r.DailyPrice ) )
                    .OrderBy( r => r.Name )
                    .ToList()
                : [];
            
            var selectedRoomWasCleared = false;

            if ( model.CoolingRoomId is not null
                 && !rooms.Any( r => r.Id == model.CoolingRoomId.Value ) )
            {
                model.CoolingRoomId = null;
                ResetPricing();
                selectedRoomWasCleared = true;

                ShowDialogWarning( "Seçili soğuk oda bu tarih aralığında uygun değil. Lütfen başka bir oda seçin." );
            }

            if ( rooms.Count == 0 )
            {
                roomsInfoMessage = "Seçilen tarih aralığında uygun oda yok.";
                ShowDialogWarning( roomsInfoMessage );
            }
            else if ( !selectedRoomWasCleared )
            {
                ClearDialogResultMessage();
            }

            ValidateReservationPricing();
        }
        finally
        {
            isLoadingRooms = false;
        }
    }

    private async Task OnDatesChanged()
    {
        await LoadAvailableRoomsAsync();
        ValidateReservationPricing();
        await InvokeAsync( StateHasChanged );
    }

    private void OnCoolingRoomChanged()
    {
        if ( SelectedRoom is null )
        {
            ResetPricing();
            ValidateReservationPricing();
            return;
        }

        model.AppliedDailyPrice = SelectedRoom.DailyPrice;
        model.PriceOverrideReason = null;
        model.PriceOverrideNote = null;

        ValidateReservationPricing();
    }

    private void OnPricingInputChanged()
        => ValidateReservationPricing();

    private void ValidateReservationPricing()
    {
        ValidatePriceOverrideReason();
        ValidatePaidAtReservationAgainstTotalAmount();
    }

    private void ValidatePriceOverrideReason()
    {
        var priceOverrideReasonField = FieldIdentifier.Create( () => model.PriceOverrideReason );
        validationMessageStore.Clear( priceOverrideReasonField );
        hasPriceOverrideReasonError = false;

        if ( HasPriceOverride && string.IsNullOrWhiteSpace( model.PriceOverrideReason ) )
        {
            validationMessageStore.Add( priceOverrideReasonField, "Fiyat değişikliği sebebi zorunludur." );
            hasPriceOverrideReasonError = true;
        }

        editContext.NotifyValidationStateChanged();
    }

    private void ValidatePaidAtReservationAgainstTotalAmount()
    {
        var paidAtReservationField = FieldIdentifier.Create( () => model.PaidAtReservation );
        validationMessageStore.Clear( paidAtReservationField );
        hasPaidAmountExceedsTotalError = false;

        if ( TryGetTotalReservationAmount( out var totalReservationAmount )
             && TotalPaidAtReservation > totalReservationAmount )
        {
            validationMessageStore.Add( paidAtReservationField, "Toplam alınan ödeme toplam rezervasyon tutarından büyük olamaz." );
            hasPaidAmountExceedsTotalError = true;
        }

        editContext.NotifyValidationStateChanged();
    }

    private bool TryGetTotalReservationAmount( out decimal totalReservationAmount )
    {
        totalReservationAmount = 0;

        if ( model.CoolingRoomId is null
             || model.DeliveryDate is null
             || model.PickUpDate is null
             || model.AppliedDailyPrice <= 0
             || !TimeOnly.TryParse( model.DeliveryTime, out var deliveryTime )
             || !TimeOnly.TryParse( model.PickUpTime, out var pickUpTime ) )
        {
            return false;
        }

        var selectedRoom = rooms.FirstOrDefault( r => r.Id == model.CoolingRoomId.Value );
        if ( selectedRoom is null )
        {
            return false;
        }

        var deliveryDateTime = model.DeliveryDate.Value.ToDateTime( deliveryTime );
        var pickUpDateTime = model.PickUpDate.Value.ToDateTime( pickUpTime );
        if ( pickUpDateTime < deliveryDateTime )
        {
            return false;
        }

        var totalDays = CalculateTotalDays( deliveryDateTime, pickUpDateTime );
        totalReservationAmount = model.AppliedDailyPrice * totalDays;
        return true;
    }

    private static int CalculateTotalDays( DateTime deliveryDateTime, DateTime pickUpDateTime )
    {
        var totalDays = ( pickUpDateTime.Date - deliveryDateTime.Date ).Days;
        var sameDayExtraAllowed = pickUpDateTime.TimeOfDay <= deliveryDateTime.TimeOfDay.Add( TimeSpan.FromHours( 2 ) );

        if ( totalDays == 0 || ( totalDays == 1 && sameDayExtraAllowed ) )
        {
            return 1;
        }

        return sameDayExtraAllowed ? totalDays : totalDays + 1;
    }

    private void ResetPricing()
    {
        model.AppliedDailyPrice = 0;
        model.PriceOverrideReason = null;
        model.PriceOverrideNote = null;
    }

    private static bool IsNoPay( string? name )
        => string.Equals( name?.Trim(), "NoPay", StringComparison.OrdinalIgnoreCase );

    private static Guid? TryParseGuid( string? value )
        => Guid.TryParse( value, out var id ) ? id : null;

    private void HandleInvalidSubmit()
    {
        submitAttempted = true;
        ValidateReservationPricing();

        var validationMessage = editContext.GetValidationMessages().FirstOrDefault();
        if ( !string.IsNullOrWhiteSpace( validationMessage ) )
        {
            ShowDialogError( validationMessage );
        }
    }

    private bool TryEnsureRequiredSelections(
        out Guid customerId,
        out Guid coolingRoomId,
        out Guid paymentTypeId )
    {
        customerId = default;
        coolingRoomId = default;
        paymentTypeId = default;

        if ( model.CustomerId is null )
        {
            ShowDialogError( "Müşteri seçin!" );
            return false;
        }

        if ( model.CoolingRoomId is null )
        {
            ShowDialogError( "Soğuk oda seçin!" );
            return false;
        }

        if ( model.PaymentTypeId is null )
        {
            ShowDialogError( "Ödeme tipi seçin!" );
            return false;
        }

        customerId = model.CustomerId.Value;
        coolingRoomId = model.CoolingRoomId.Value;
        paymentTypeId = model.PaymentTypeId.Value;
        return true;
    }

    private async Task HandleValidSubmit()
    {
        if ( ReservationId is null )
        {
            return;
        }

        if ( IsReservationEnded )
        {
            ShowDialogError( "Bitiş tarihi geçmiş rezervasyon güncellenemez." );
            return;
        }

        try
        {
            isSubmit = true;
            submitAttempted = true;

            ValidateReservationPricing();

            if ( hasPaidAmountExceedsTotalError || hasPriceOverrideReasonError )
            {
                var validationMessage = editContext.GetValidationMessages().FirstOrDefault();
                if ( !string.IsNullOrWhiteSpace( validationMessage ) )
                {
                    ShowDialogError( validationMessage );
                }
                return;
            }

            if ( model.DeliveryDate is null || model.PickUpDate is null )
            {
                ShowDialogError( "Lütfen rezervasyon başlangıç ve bitiş tarihlerini seçin." );
                return;
            }

            if ( !TimeOnly.TryParse( model.DeliveryTime, out var deliveryTime ) )
            {
                ShowDialogError( "Rezervasyon saatini doğru giriniz!" );
                return;
            }

            if ( !TimeOnly.TryParse( model.PickUpTime, out var pickUpTime ) )
            {
                ShowDialogError( "Rezervasyon alma saatini doğru giriniz!" );
                return;
            }

            if ( !paymentReceived && noPayPaymentTypeId is null )
            {
                ShowDialogError( "NoPay ödeme tipi bulunamadı." );
                return;
            }

            if ( !TryEnsureRequiredSelections(
                out var customerId,
                out var coolingRoomId,
                out var paymentTypeId ) )
            {
                return;
            }

            var paidAtReservation = TotalPaidAtReservation;

            var request = new UpdateReservationRequest
            {
                Id = ReservationId.Value,
                CustomerId = customerId,
                CoolingRoomId = coolingRoomId,
                DeliveryLocation = model.DeliveryLocation,
                DeliveryDate = model.DeliveryDate.Value,
                DeliveryTime = deliveryTime,
                PickUpDate = model.PickUpDate.Value,
                PickUpTime = pickUpTime,
                AppliedDailyPrice = model.AppliedDailyPrice,
                PriceOverrideReason = HasPriceOverride ? model.PriceOverrideReason?.Trim() : null,
                PriceOverrideNote = HasPriceOverride ? model.PriceOverrideNote?.Trim() : null,
                Status = ( int )model.Status,
                PaymentTypeId = paymentTypeId,
                PaidAtReservation = paidAtReservation,
                Note = string.IsNullOrWhiteSpace( model.Note ) ? null : model.Note
            };

            var result = await reservationService.UpdateAsync( ReservationId.Value, request );
            apiResultPresenter.Present( result, new ApiPresentationOptions { ShowSuccess = true } );

            var resultMessage = GetResultMessage(
                result,
                result.IsSuccessful
                    ? "Rezervasyon başarıyla güncellendi."
                    : "Rezervasyon güncellenemedi." );

            if ( !result.IsSuccessful )
            {
                ShowDialogResultMessage( resultMessage, "alert-danger" );
                return;
            }

            ShowDialogResultMessage( resultMessage, "alert-success" );
            operationCompleted = true;

            if ( ReservationUpdated.HasDelegate )
            {
                await ReservationUpdated.InvokeAsync();
            }
        }
        finally
        {
            isSubmit = false;
        }
    }

    private void ShowDialogError( string message )
    {
        ShowDialogResultMessage( message, "alert-danger" );
        toastService.ShowError( message );
    }

    private void ShowDialogWarning( string message )
    {
        ShowDialogResultMessage( message, "alert-warning" );
        toastService.ShowWarning( message );
    }

    private void ShowDialogResultMessage( string message, string cssClass )
    {
        dialogResultMessage = message;
        dialogResultCssClass = cssClass;
    }

    private void ClearDialogResultMessage()
    {
        dialogResultMessage = null;
        dialogResultCssClass = "alert-info";
    }

    private static string GetResultMessage( Result<string> result, string fallback )
    {
        if ( result.IsSuccessful )
        {
            return string.IsNullOrWhiteSpace( result.Data )
                ? fallback
                : result.Data;
        }

        return result.ErrorMessages?.FirstOrDefault( x => !string.IsNullOrWhiteSpace( x ) )
            ?? fallback;
    }

    private sealed class UpdateReservationViewModel
    {
        [Required( ErrorMessage = "Müşteri seçin!" )]
        public Guid? CustomerId { get; set; }

        [Required( ErrorMessage = "Soğuk oda seçin!" )]
        public Guid? CoolingRoomId { get; set; }

        [Required( ErrorMessage = "Teslimat konumu girin!" )]
        public string DeliveryLocation { get; set; } = string.Empty;

        [Required( ErrorMessage = "Rezervasyon başlangıç tarihi seçin!" )]
        public DateOnly? DeliveryDate { get; set; }

        [Required( ErrorMessage = "Rezervasyon saati girin!" )]
        [RegularExpression( @"^\d{2}:\d{2}$", ErrorMessage = "Saat formatı HH:mm olmalı." )]
        public string DeliveryTime { get; set; } = "09:00";

        [Required( ErrorMessage = "Rezervasyon bitiş tarihi seçin!" )]
        public DateOnly? PickUpDate { get; set; }

        [Required( ErrorMessage = "Rezervasyon bitiş saati girin!" )]
        [RegularExpression( @"^\d{2}:\d{2}$", ErrorMessage = "Saat formatı HH:mm olmalı." )]
        public string PickUpTime { get; set; } = "09:00";

        [Range( 0.01, double.MaxValue, ErrorMessage = "Uygulanacak günlük fiyat sıfırdan büyük olmalıdır." )]
        public decimal AppliedDailyPrice { get; set; }

        [StringLength( 250, ErrorMessage = "Fiyat değişikliği sebebi en fazla 250 karakter olabilir." )]
        public string? PriceOverrideReason { get; set; }

        [StringLength( 500, ErrorMessage = "Fiyat değişikliği notu en fazla 500 karakter olabilir." )]
        public string? PriceOverrideNote { get; set; }

        public ReservationOperationStatusDto Status { get; set; } = ReservationOperationStatusDto.Scheduled;

        [Required( ErrorMessage = "Ödeme tipi seçin!" )]
        public Guid? PaymentTypeId { get; set; }

        [Range( 0, double.MaxValue, ErrorMessage = "Ödeme tutarı negatif olamaz." )]
        public decimal PaidAtReservation { get; set; }

        public string? Note { get; set; }
    }

    private sealed record CustomerOption( Guid Id, string FullName, string PhoneNumber )
    {
        public string CustomerDisplay => $"{FullName} - {PhoneNumber}";
    }

    private sealed record CoolingRoomOption( Guid Id, string Name, decimal DailyPrice );

    private sealed record PaymentTypeOption( Guid Id, string Name );
}

