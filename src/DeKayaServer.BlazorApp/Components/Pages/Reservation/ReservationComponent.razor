@page "/reservation-cooling-rooms"
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeKayaServer.BlazorApp.Components.Pages.Reservation.CreateReservation
@using DeKayaServer.BlazorApp.Components.Pages.Reservation.UpdateReservation
@using DeKayaServer.BlazorApp.Components.Pages.Reservation.DeleteReservation
@using DeKayaServer.BlazorApp.Components.Pages.Reservation.DetailReservation
@using DeKayaServer.BlazorApp.Components.Pages.Reservation.CompleteReservation
@using DeKayaServer.Contracts.Reservations
@using DeKayaServer.Contracts.Reservations.Enum
@inherits UserContextComponent
@inject IReservationService reservationService
@rendermode InteractiveServer

<PageTitle>De-Kaya Systems | @PageTitleConstans.ReservationsPage</PageTitle>

<PageHeader Title="Seyyar Soğutma Odası Rezervasyonları"
            Icon="bi bi-calendar-check"
            Description="Bu sayfada seyyar soğutma odalarının rezervasyon işlemlerini yönetebilirsin." />

@if ( !string.IsNullOrWhiteSpace( errorMessage ) )
{
    <div class="alert alert-danger mt-3 mb-0">
        @errorMessage
    </div>
}

@if ( isLoading )
{
    <div class="mt-3">
        <IsLoading Message="Rezervasyonlar yükleniyor, lütfen bekleyin." />
    </div>
}

<DeKayaQuickGrid Title="Rezervasyonlar"
                 ShowTitle="true"
                 ShowSearchResultCount="true"
                 TotalItemCount="@totalItemCount"
                 ShowPageSizeSelector="true"
                 PageSize="@pageSize"
                 PageSizeChanged="OnPageSizeChanged">

    <HeaderActions>
        <button type="button"
                class="btn btn-outline-success btn-sm"
                @onclick="ShowCreateReservationDialog">
            <i class="bi bi-plus-circle"></i>
            <span>Ekle</span>
        </button>
    </HeaderActions>

    <QuickGridContent>
        <div class="p-3 border-bottom bg-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label small text-body-secondary">Müşteri adı</label>
                    <input class="form-control form-control-sm"
                           placeholder="Müşteri ara..."
                           @bind="customerNameFilter"
                           @bind:event="oninput" />
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label small text-body-secondary">Rezervasyon Başlangıç</label>
                    <input class="form-control form-control-sm"
                           type="date"
                           @bind="reservationStartDateFilter" />
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label small text-body-secondary">Rezervasyon Bitiş</label>
                    <input class="form-control form-control-sm"
                           type="date"
                           @bind="reservationEndDateFilter" />
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label small text-body-secondary">Operasyon Durumu</label>
                    <select class="form-select form-select-sm"
                            @bind="operationStatusFilter">
                        <option value="">Tümü</option>

                        @foreach ( var option in OperationStatusOptions )
                        {
                            <option value="@(( int )option.Value)">
                                @option.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            @onclick="ApplyFiltersAsync">
                        Filtrele
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="ClearFiltersAsync">
                        Temizle
                    </button>
                </div>
            </div>
        </div>

        <QuickGrid 
                TGridItem="ReservationListItemDto"
                @ref="grid"
                ItemsProvider="@LoadReservationsAsync"
                Pagination="pagination"
                Class="table table-striped table-hover table-responsive mb-0 align-middle">

            <PropertyColumn Property="@(r => r.CustomerFullName)"
                            Title="Müşteri" />

            <PropertyColumn Property="@(r => r.ReservationNumber)"
                            Title="Rezervasyon No" />

            <PropertyColumn Property="@(r => r.CoolingRoomName)"
                            Title="Oda" />

            <PropertyColumn Property="@(r => r.ReservationStart)"
                            Title="Rezervasyon Başlangıç"
                            Format="dd-MM-yyyy - HH:mm" />

            <PropertyColumn Property="@(r => r.ReservationEnd)"
                            Title="Rezervasyon Bitiş"
                            Format="dd-MM-yyyy - HH:mm" />

            <TemplateColumn Title="Operasyon Durumu" Context="r">
                <span class="badge @GetOperationStatusBadgeClass( r ) p-2">
                    @Display( r.OperationStatusText )
                </span>
            </TemplateColumn>

            <PropertyColumn Property="@(r => r.TotalDays)"
                            Title="Toplam Gün" />

            <TemplateColumn Title="Toplam Tutar" Context="r">
                @FormatMoney( r.TotalAmount )
            </TemplateColumn>

            <TemplateColumn Title="İşlemler" Context="r">
                <div class="d-flex gap-2 py-1 justify-content-start">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="() => ShowDetailReservationDialog( r )">
                        <i class="bi bi-search"></i>
                        <span>Detay</span>
                    </button>

                    @if ( CurrentUser.HasPermission( "reservation:edit" ) )
                    {
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                @onclick="() => ShowUpdateReservationDialog( r )">
                            <i class="bi bi-pen"></i>
                            <span>Güncelle</span>
                        </button>
                    }

                    @if ( CurrentUser.HasPermission( "reservation:edit" ) && CanCompleteReservation( r ) )
                    {
                        <button type="button"
                                class="btn btn-outline-success btn-sm"
                                @onclick="() => ShowCompleteReservationDialog( r )">
                            <i class="bi bi-check2-circle"></i>
                            <span>Tamamla</span>
                        </button>
                    }

                    @if ( CurrentUser.HasPermission( "reservation:delete" ) )
                    {
                        var canDeleteReservation = CanDeleteReservation( r );

                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                disabled="@(!canDeleteReservation)"
                                title="@GetDeleteButtonTitle( r )"
                                @onclick="() => ShowDeleteReservationDialog( r )">
                            <i class="bi bi-trash"></i>
                            <span>Sil</span>
                        </button>
                    }
                </div>
            </TemplateColumn>
        </QuickGrid>

        <div class="p-2">
            <Paginator State="pagination" />
        </div>
    </QuickGridContent>
</DeKayaQuickGrid>

<CreateReservationDialog @ref="createReservationDialog"
                         ReservationAdded="RefreshGridAsync" />

<DetailReservationDialog @ref="detailReservationDialog"
                         ReservationId="@selectedReservationId" />

<UpdateReservationDialog @ref="updateReservationDialog"
                         ReservationId="@selectedReservationId"
                         ReservationUpdated="RefreshGridAsync" />

<CompleteReservationDialog @ref="completeReservationDialog"
                           ReservationId="@selectedReservationId"
                           ReservationCompleted="RefreshGridAsync" />

<DeleteReservationDialog @ref="deleteReservationDialog"
                         ReservationId="@selectedReservationId"
                         ReservationNumber="@selectedReservationNumber"
                         ReservationDeleted="RefreshGridAsync" />

@code {
    private QuickGrid<ReservationListItemDto>? grid;

    private bool isLoading = true;
    private bool hasLoadedReservations;
    private string? errorMessage;
    private int totalItemCount;
    private int pageSize = 25;
    private PaginationState pagination = new() { ItemsPerPage = 25 };

    private string customerNameFilter = string.Empty;
    private DateOnly? reservationStartDateFilter;
    private DateOnly? reservationEndDateFilter;
    private string operationStatusFilter = string.Empty;

    private CreateReservationDialog? createReservationDialog;
    private DetailReservationDialog? detailReservationDialog;
    private UpdateReservationDialog? updateReservationDialog;
    private CompleteReservationDialog? completeReservationDialog;
    private DeleteReservationDialog? deleteReservationDialog;

    private Guid? selectedReservationId;
    private string? selectedReservationNumber;

    private static readonly OperationStatusOption[] OperationStatusOptions =
    [
        new( ReservationOperationFilterDto.Reserved, "Rezerve edildi" ),
        new( ReservationOperationFilterDto.WaitingDelivery, "Teslimat bekliyor" ),
        new( ReservationOperationFilterDto.DeliveredToCustomer, "Müşteriye teslim edildi" ),
        new( ReservationOperationFilterDto.WaitingPickup, "Geri alım bekleniyor" ),
        new( ReservationOperationFilterDto.PickedUpFromCustomer, "Müşteriden geri alındı" ),
        new( ReservationOperationFilterDto.Completed, "Tamamlandı" )
    ];

    private ReservationOperationFilterDto? SelectedOperationStatus
    {
        get
        {
            if ( string.IsNullOrWhiteSpace( operationStatusFilter ) )
            {
                return null;
            }

            return Enum.TryParse<ReservationOperationFilterDto>( operationStatusFilter, out var status )
                ? status
                : null;
        }
    }

    private async ValueTask<GridItemsProviderResult<ReservationListItemDto>> LoadReservationsAsync(
        GridItemsProviderRequest<ReservationListItemDto> request )
    {
        errorMessage = null;

        try
        {
            var resolvedPageSize = request.Count ?? pageSize;
            var pageIndex = resolvedPageSize <= 0
                ? 0
                : request.StartIndex / resolvedPageSize;

            var result = await reservationService.GetListAsync(
                customerName: customerNameFilter,
                reservationStartDate: reservationStartDateFilter,
                reservationEndDate: reservationEndDateFilter,
                operationStatus: SelectedOperationStatus,
                pageIndex: pageIndex,
                pageSize: resolvedPageSize,
                cancellationToken: CancellationToken.None );

            if ( !result.IsSuccessful || result.Data is null )
            {
                totalItemCount = 0;
                errorMessage = result.ErrorMessages?.FirstOrDefault()
                    ?? "Rezervasyonlar getirilemedi.";

                return GridItemsProviderResult.From(
                    items: Array.Empty<ReservationListItemDto>(),
                    totalItemCount: 0 );
            }

            totalItemCount = result.Data.TotalCount;

            return GridItemsProviderResult.From(
                items: result.Data.Items,
                totalItemCount: result.Data.TotalCount );
        }
        finally
        {
            if ( !hasLoadedReservations )
            {
                hasLoadedReservations = true;
                isLoading = false;
                await InvokeAsync( StateHasChanged );
            }
        }
    }

    private async Task ApplyFiltersAsync()
    {
        await pagination.SetCurrentPageIndexAsync( 0 );
        await RefreshGridAsync();
    }

    private async Task ClearFiltersAsync()
    {
        customerNameFilter = string.Empty;
        reservationStartDateFilter = null;
        reservationEndDateFilter = null;
        operationStatusFilter = string.Empty;

        await ApplyFiltersAsync();
    }

    private async Task OnPageSizeChanged( int value )
    {
        pageSize = value;
        pagination.ItemsPerPage = value;

        await pagination.SetCurrentPageIndexAsync( 0 );
        await RefreshGridAsync();
    }

    private async Task RefreshGridAsync()
    {
        isLoading = true;
        await InvokeAsync( StateHasChanged );

        try
        {
            if ( grid is not null )
            {
                await grid.RefreshDataAsync();
            }
        }
        finally
        {
            isLoading = false;
            await InvokeAsync( StateHasChanged );
        }
    }

    private async Task ShowCreateReservationDialog()
    {
        if ( createReservationDialog is null )
        {
            return;
        }

        await createReservationDialog.ShowAsync();
    }

    private async Task ShowDetailReservationDialog( ReservationListItemDto reservation )
    {
        selectedReservationId = reservation.Id;

        await InvokeAsync( StateHasChanged );
        await Task.Yield();

        if ( detailReservationDialog is null )
        {
            return;
        }

        await detailReservationDialog.ShowAsync();
    }

    private async Task ShowUpdateReservationDialog( ReservationListItemDto reservation )
    {
        selectedReservationId = reservation.Id;

        await InvokeAsync( StateHasChanged );
        await Task.Yield();

        if ( updateReservationDialog is null )
        {
            return;
        }

        await updateReservationDialog.ShowAsync();
    }

    private async Task ShowCompleteReservationDialog( ReservationListItemDto reservation )
    {
        selectedReservationId = reservation.Id;

        await InvokeAsync( StateHasChanged );
        await Task.Yield();

        if ( completeReservationDialog is null )
        {
            return;
        }

        await completeReservationDialog.ShowAsync();
    }

    private async Task ShowDeleteReservationDialog( ReservationListItemDto reservation )
    {
        selectedReservationId = reservation.Id;
        selectedReservationNumber = reservation.ReservationNumber;

        await InvokeAsync( StateHasChanged );
        await Task.Yield();

        if ( deleteReservationDialog is null )
        {
            return;
        }

        await deleteReservationDialog.ShowAsync();
    }

    private static bool CanCompleteReservation( ReservationListItemDto reservation )
    {
        var reservationStatus = ( ReservationOperationStatusDto )reservation.Status;

        if ( reservationStatus is ReservationOperationStatusDto.Completed
            or ReservationOperationStatusDto.PickedUpFromCustomer
            or ReservationOperationStatusDto.Cancelled )
        {
            return false;
        }

        if ( reservation.OperationStatus == ReservationOperationFilterDto.WaitingPickup )
        {
            return true;
        }

        if ( reservationStatus == ReservationOperationStatusDto.Scheduled
             && reservation.ReservationEnd <= DateTime.Now )
        {
            return true;
        }

        return false;
    }

    private bool CanDeleteReservation( ReservationListItemDto reservation )
    {
        if ( CurrentUser.IsSysAdmin )
        {
            return true;
        }

        return !IsCompletedReservation( reservation );
    }

    private static bool IsCompletedReservation( ReservationListItemDto reservation )
        => ( ReservationOperationStatusDto )reservation.Status == ReservationOperationStatusDto.Completed;

    private string GetDeleteButtonTitle( ReservationListItemDto reservation )
    {
        if ( CanDeleteReservation( reservation ) )
        {
            return "Rezervasyonu sil";
        }

        return "Tamamlanmış rezervasyonları sadece sys_admin silebilir.";
    }

    private static string GetOperationStatusBadgeClass( ReservationListItemDto reservation )
        => reservation.OperationStatus switch
        {
            ReservationOperationFilterDto.Reserved => "bg-info text-dark",
            ReservationOperationFilterDto.WaitingDelivery => "bg-warning text-dark",
            ReservationOperationFilterDto.DeliveredToCustomer => "bg-primary",
            ReservationOperationFilterDto.WaitingPickup => "bg-warning text-dark",
            ReservationOperationFilterDto.PickedUpFromCustomer => "bg-success",
            ReservationOperationFilterDto.Completed => "bg-success",
            _ => "bg-secondary"
        };

    private static string Display( string? value )
        => string.IsNullOrWhiteSpace( value ) ? "—" : value;

    private static string FormatMoney( decimal value )
        => value.ToString( "N2" ) + " ₺";

    private sealed record OperationStatusOption(
        ReservationOperationFilterDto Value,
        string Text );
}
