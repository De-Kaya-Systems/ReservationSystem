@using DeKayaServer.BlazorApp.Components.Common.Dialog
@using DeKayaServer.BlazorApp.Models
@using DeKayaServer.Contracts.Reservations
@using TS.Result
@inject IReservationService reservationService
@inject IApiResultPresenter apiResultPresenter
@inject ToastService toastService
@rendermode InteractiveServer

<Dialog @ref="dialog"
        Title="Teslim Kaydı Gir">
    <ChildContent>
        @if ( isLoading )
        {
            <IsLoading Message="Rezervasyon bilgileri yükleniyor, lütfen bekleyin." />
        }
        else if ( reservation is null )
        {
            <div class="alert alert-warning mb-0">
                Rezervasyon bilgisi bulunamadı.
            </div>
        }
        else
        {
            @if ( !string.IsNullOrWhiteSpace( dialogResultMessage ) )
            {
                <div class="alert @dialogResultCssClass py-2 px-3 mb-3">
                    @dialogResultMessage
                </div>
            }

            <div class="alert alert-info py-2 px-3 mb-3">
                Bu işlem yalnızca eksik teslim kaydını tamamlar. Rezervasyonun diğer bilgileri değiştirilmez.
            </div>

            <div class="mb-3">
                <div class="text-body-secondary small">Rezervasyon</div>
                <div class="fw-semibold">@Display( reservation.ReservationNumber )</div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label class="form-label">Gerçek teslim tarihi</label>
                    <InputDate class="form-control" @bind-Value="model.DeliveredDate" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Gerçek teslim saati</label>
                    <InputText class="form-control"
                               type="time"
                               @bind-Value="model.DeliveredTime" />
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end mt-4 pt-3 border-top">
                <button type="button"
                        class="btn btn-outline-secondary px-4 py-2 fw-semibold"
                        @onclick="HideAsync"
                        disabled="@isSubmit">
                    @( operationCompleted ? "Kapat" : "İptal" )
                </button>

                <button type="button"
                        class="btn btn-outline-primary px-4 py-2 fw-semibold"
                        @onclick="HandleMarkDeliveredAsync"
                        disabled="@(isSubmit || operationCompleted)">
                    Teslim Edildi Olarak İşaretle
                </button>
            </div>
        }
    </ChildContent>
</Dialog>

@code {
    private Dialog? dialog;
    private bool isLoading;
    private bool isSubmit;
    private bool operationCompleted;

    private ReservationDto? reservation;
    private MarkDeliveredViewModel model = new();

    private string? dialogResultMessage;
    private string dialogResultCssClass = "alert-info";

    [Parameter] public Guid? ReservationId { get; set; }
    [Parameter] public EventCallback ReservationDelivered { get; set; }

    public async Task ShowAsync()
    {
        if ( dialog is null || ReservationId is null )
        {
            return;
        }

        InitForm();
        isLoading = true;

        await dialog.ShowAsync();
        await InvokeAsync( StateHasChanged );

        await LoadReservationAsync( ReservationId.Value );

        isLoading = false;
        await InvokeAsync( StateHasChanged );
    }

    public async Task HideAsync()
    {
        if ( dialog is null )
        {
            return;
        }

        await dialog.HideAsync();
    }

    private void InitForm()
    {
        reservation = null;
        operationCompleted = false;
        dialogResultMessage = null;
        dialogResultCssClass = "alert-info";
        model = new MarkDeliveredViewModel();
    }

    private async Task LoadReservationAsync( Guid reservationId )
    {
        var result = await reservationService.GetByIdAsync( reservationId );

        if ( !result.IsSuccessful || result.Data is null )
        {
            ShowDialogError( result.ErrorMessages?.FirstOrDefault() ?? "Rezervasyon getirilemedi." );
            return;
        }

        reservation = result.Data;
        model.DeliveredDate = reservation.DeliveryDate;
        model.DeliveredTime = TimeOnly.FromDateTime( reservation.DeliveryTime ).ToString( "HH:mm" );
    }

    private async Task HandleMarkDeliveredAsync()
    {
        if ( ReservationId is null || reservation is null )
        {
            ShowDialogError( "Teslim kaydı girilecek rezervasyon bulunamadı." );
            return;
        }

        if ( model.DeliveredDate is null )
        {
            ShowDialogError( "Gerçek teslim tarihini seçin." );
            return;
        }

        if ( !TimeOnly.TryParse( model.DeliveredTime, out var deliveredTime ) )
        {
            ShowDialogError( "Gerçek teslim saatini doğru girin." );
            return;
        }

        var deliveredAt = model.DeliveredDate.Value.ToDateTime( deliveredTime );

        if ( deliveredAt > DateTime.Now )
        {
            ShowDialogError( "Gerçek teslim tarihi gelecek bir tarih olamaz." );
            return;
        }

        try
        {
            isSubmit = true;

            var request = new MarkReservationDeliveredRequest
            {
                Id = ReservationId.Value,
                DeliveredAt = deliveredAt
            };

            var result = await reservationService.MarkAsDeliveredAsync( ReservationId.Value, request );
            apiResultPresenter.Present( result, new ApiPresentationOptions { ShowSuccess = true } );

            var resultMessage = GetResultMessage(
                result,
                result.IsSuccessful
                    ? "Rezervasyon müşteriye teslim edildi olarak işaretlendi."
                    : "Teslim kaydı girilemedi." );

            if ( !result.IsSuccessful )
            {
                ShowDialogResultMessage( resultMessage, "alert-danger" );
                return;
            }

            ShowDialogResultMessage( resultMessage, "alert-success" );
            operationCompleted = true;

            if ( ReservationDelivered.HasDelegate )
            {
                await ReservationDelivered.InvokeAsync();
            }
        }
        finally
        {
            isSubmit = false;
        }
    }

    private void ShowDialogError( string message )
    {
        ShowDialogResultMessage( message, "alert-danger" );
        toastService.ShowError( message );
    }

    private void ShowDialogResultMessage( string message, string cssClass )
    {
        dialogResultMessage = message;
        dialogResultCssClass = cssClass;
    }

    private static string GetResultMessage( Result<string> result, string fallback )
    {
        if ( result.IsSuccessful )
        {
            return string.IsNullOrWhiteSpace( result.Data )
                ? fallback
                : result.Data;
        }

        return result.ErrorMessages?.FirstOrDefault( x => !string.IsNullOrWhiteSpace( x ) )
            ?? fallback;
    }

    private static string Display( string? value )
        => string.IsNullOrWhiteSpace( value ) ? "—" : value;

    private sealed class MarkDeliveredViewModel
    {
        public DateOnly? DeliveredDate { get; set; }
        public string DeliveredTime { get; set; } = "09:00";
    }
}
