@using DeKayaServer.BlazorApp.Components.Common.Dialog
@using DeKayaServer.BlazorApp.Models
@using DeKayaServer.BlazorApp.Services
@using DeKayaServer.Contracts.CoolingRooms
@using DeKayaServer.Contracts.Reservations

@inject ICoolingRoomService coolingRoomService
@inject IApiResultPresenter apiResultPresenter
@inherits UserContextComponent

<Dialog @ref="dialog"
        Title="Oda Detayı">
    <ChildContent>
        @if ( isLoading )
        {
            <IsLoading Message="Oda bilgileri getiriliyor, lütfen bekleyin." />
        }
        else if ( hasLoaded && room is null )
        {
            <div class="alert alert-warning mb-0">
                Oda bulunamadı.
            </div>
        }
        else if ( room is not null )
        {
            <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="mb-0">@Display( room.RoomName )</h5>

                        <span class="badge p-2 @GetStatusBadgeClass( room )">
                            <i class="bi @GetStatusIcon( room ) me-1"></i>
                            @GetOperationText( room )
                        </span>

                        <span class="badge p-2 @(room.IsActive ? "bg-success" : "bg-secondary")">
                            <i class="bi @(room.IsActive ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                            @(room.IsActive ? "Oda Aktif" : "Oda Pasif")
                        </span>

                        <span class="badge p-2 @(room.Shelf ? "bg-info" : "bg-light text-dark border")">
                            <i class="bi @(room.Shelf ? "bi-inboxes" : "bi-box") me-1"></i>
                            @(room.Shelf ? "Raflı" : "Rafsız")
                        </span>
                    </div>

                    @if ( CurrentUser.HasPermission( RoleConstants.SysAdmin ) )
                    {
                        <div class="text-muted small mt-1">
                            Oda Id: <span class="font-monospace">@room.Id</span>
                        </div>
                    }
                </div>

                <div class="text-end">
                    <div class="text-muted small">Günlük fiyat</div>
                    <div class="fw-semibold">@FormatMoney( room.DailyPrice )</div>
                </div>
            </div>

            <hr class="my-3" />

            <div class="row g-3">

                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-body d-flex align-items-center gap-2">
                            <i class="bi bi-thermometer-snow"></i>
                            <span class="fw-semibold">Oda Bilgileri</span>
                        </div>

                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-5 text-muted fw-normal">Oda Adı</dt>
                                <dd class="col-7 mb-2">@Display( room.RoomName )</dd>

                                <dt class="col-5 text-muted fw-normal">Durum</dt>
                                <dd class="col-7 mb-2">@GetOperationText( room )</dd>

                                <dt class="col-5 text-muted fw-normal">Sistem Durumu</dt>
                                <dd class="col-7 mb-2">@Display( room.StatusName )</dd>

                                <dt class="col-5 text-muted fw-normal">Raf</dt>
                                <dd class="col-7 mb-2">@(room.Shelf ? "Raflı" : "Rafsız")</dd>

                                <dt class="col-5 text-muted fw-normal">Günlük Fiyat</dt>
                                <dd class="col-7 mb-0">@FormatMoney( room.DailyPrice )</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-body d-flex align-items-center gap-2">
                            <i class="bi bi-person-lines-fill"></i>
                            <span class="fw-semibold">Müşteri / Aktif Rezervasyon</span>
                        </div>

                        <div class="card-body">
                            @if ( room.CurrentReservationId is null )
                            {
                                <div class="text-muted">
                                    Şu anda aktif rezervasyon yok.
                                </div>
                            }
                            else
                            {
                                <dl class="row mb-0">
                                    <dt class="col-5 text-muted fw-normal">Rezervasyon</dt>
                                    <dd class="col-7 mb-2">@Display( room.CurrentReservationNumber )</dd>

                                    <dt class="col-5 text-muted fw-normal">Müşteri</dt>
                                    <dd class="col-7 mb-2">@Display( room.CurrentCustomerName )</dd>

                                    <dt class="col-5 text-muted fw-normal">Telefon</dt>
                                    <dd class="col-7 mb-2">@Display( room.CurrentCustomerPhoneNumber )</dd>

                                    <dt class="col-5 text-muted fw-normal">Başlangıç</dt>
                                    <dd class="col-7 mb-2">@DisplayDateTime( room.CurrentReservationStart )</dd>

                                    <dt class="col-5 text-muted fw-normal">Bitiş</dt>
                                    <dd class="col-7 mb-2">@DisplayDateTime( room.CurrentReservationEnd )</dd>

                                    <dt class="col-5 text-muted fw-normal">Teslim</dt>
                                    <dd class="col-7 mb-2">@DisplayDateTime( room.DeliveredAt )</dd>

                                    <dt class="col-5 text-muted fw-normal">Geri Alım</dt>
                                    <dd class="col-7 mb-0">@DisplayDateTime( room.PickedUpAt )</dd>
                                </dl>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-body d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-event"></i>
                            <span class="fw-semibold">Planlama</span>
                        </div>

                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-5 text-muted fw-normal">Sonraki Rez.</dt>
                                <dd class="col-7 mb-2">@Display( room.NextReservationNumber )</dd>

                                <dt class="col-5 text-muted fw-normal">Sonraki Müşteri</dt>
                                <dd class="col-7 mb-2">@Display( room.NextCustomerName )</dd>

                                <dt class="col-5 text-muted fw-normal">Başlangıç</dt>
                                <dd class="col-7 mb-2">@DisplayDateTime( room.NextReservationStart )</dd>

                                <dt class="col-5 text-muted fw-normal">Bitiş</dt>
                                <dd class="col-7 mb-2">@DisplayDateTime( room.NextReservationEnd )</dd>

                                <dt class="col-5 text-muted fw-normal">En Yakın Müsaitlik</dt>
                                <dd class="col-7 mb-0">
                                    @if ( room.NextAvailableAt is null && IsAvailable( room ) )
                                    {
                                        <span class="text-success fw-semibold">Şimdi</span>
                                    }
                                    else
                                    {
                                        @DisplayDateTime( room.NextAvailableAt )
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-body d-flex align-items-center gap-2">
                            <i class="bi bi-cash-coin"></i>
                            <span class="fw-semibold">Finans</span>
                        </div>

                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-5 text-muted fw-normal">Kalan Borç</dt>
                                <dd class="col-7 mb-0">
                                    @if ( room.OutstandingAmount > 0 )
                                    {
                                        <span class="fw-bold text-danger">@FormatMoney( room.OutstandingAmount )</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-semibold">Borç yok</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-body d-flex align-items-center gap-2">
                            <i class="bi bi-tools"></i>
                            <span class="fw-semibold">Bakım / Arıza</span>
                        </div>

                        <div class="card-body">
                            @if ( room.MaintenanceId is null )
                            {
                                <div class="text-muted">
                                    Aktif bakım veya arıza kaydı yok.
                                </div>
                            }
                            else
                            {
                                <dl class="row mb-0">
                                    <dt class="col-5 col-md-3 text-muted fw-normal">Açıklama</dt>
                                    <dd class="col-7 col-md-9 mb-2">@Display( room.MaintenanceDescription )</dd>

                                    <dt class="col-5 col-md-3 text-muted fw-normal">Tahmini Bitiş</dt>
                                    <dd class="col-7 col-md-9 mb-0">@DisplayDate( room.MaintenanceEnd )</dd>
                                </dl>
                            }
                        </div>
                    </div>
                </div>

            </div>
        }
    </ChildContent>
</Dialog>

@code {
    private Dialog? dialog;

    private bool isLoading;
    private bool hasLoaded;
    private CoolingRoomOverviewDto? room;

    [Parameter] public Guid? CoolingRoomId { get; set; }

    public async Task ShowAsync()
    {
        if ( dialog is null || CoolingRoomId is null )
        {
            return;
        }

        room = null;
        hasLoaded = false;
        isLoading = true;

        await InvokeAsync( StateHasChanged );

        await LoadAsync( CoolingRoomId.Value );

        isLoading = false;
        hasLoaded = true;

        await InvokeAsync( StateHasChanged );
        await dialog.ShowAsync();
    }

    public async Task HideAsync()
    {
        if ( dialog is not null )
        {
            await dialog.HideAsync();
        }
    }

    private async Task LoadAsync( Guid id )
    {
        var result = await coolingRoomService.GetOverviewAsync();
        apiResultPresenter.Present( result, new ApiPresentationOptions { ShowSuccess = false } );

        if ( !result.IsSuccessful || result.Data is null )
        {
            room = null;
            return;
        }

        room = result.Data.FirstOrDefault( x => x.Id == id );
    }

    private static string GetOperationText( CoolingRoomOverviewDto room )
    {
        if ( IsFaulty( room ) )
        {
            return "Arıza/Bakım";
        }

        if ( room.CurrentReservationStatus == ( int )ReservationOperationStatusDto.DeliveredToCustomer
             && room.CurrentReservationEnd is not null
             && room.CurrentReservationEnd.Value <= DateTime.Now.AddHours( 24 ) )
        {
            return "Geri alım bekliyor";
        }

        if ( room.CurrentReservationStatus == ( int )ReservationOperationStatusDto.DeliveredToCustomer )
        {
            return "Müşteride";
        }

        if ( room.CurrentReservationStatus == ( int )ReservationOperationStatusDto.Scheduled
             && room.CurrentReservationEnd is not null
             && room.CurrentReservationEnd.Value <= DateTime.Now )
        {
            return "Teslim kaydı eksik";
        }

        if ( room.CurrentReservationStatus == ( int )ReservationOperationStatusDto.Scheduled
             && room.CurrentReservationStart is not null
             && room.CurrentReservationStart.Value <= DateTime.Now )
        {
            return "Teslimat bekliyor";
        }

        if ( IsAvailable( room ) )
        {
            return "Uygun";
        }

        if ( IsReserved( room ) )
        {
            return "Rezerve";
        }

        return Display( room.StatusName );
    }

    private static bool IsAvailable( CoolingRoomOverviewDto room )
        => IsStatus( room.StatusName, "uygun" );

    private static bool IsReserved( CoolingRoomOverviewDto room )
        => IsStatus( room.StatusName, "reserve", "rezerve" );

    private static bool IsFaulty( CoolingRoomOverviewDto room )
        => IsStatus( room.StatusName, "arıza/bakım", "ariza/bakim", "arıza", "ariza", "bakım", "bakim" );

    private static bool IsStatus( string? statusName, params string[] values )
    {
        var key = ( statusName ?? string.Empty ).Trim().ToLowerInvariant();

        return values.Any( x => x == key );
    }

    private static string Display( string? value )
        => string.IsNullOrWhiteSpace( value ) ? "—" : value;

    private static string DisplayDateTime( DateTime? value )
        => value.HasValue ? value.Value.ToString( "dd.MM.yyyy HH:mm" ) : "—";

    private static string DisplayDate( DateTime? value )
        => value.HasValue ? value.Value.ToString( "dd.MM.yyyy" ) : "—";

    private static string FormatMoney( decimal value )
        => value.ToString( "N2" ) + " ₺";

    private static string GetStatusBadgeClass( CoolingRoomOverviewDto room )
        => GetOperationText( room ) switch
        {
            "Uygun" => "bg-success",
            "Rezerve" => "bg-primary",
            "Müşteride" => "bg-warning text-dark",
            "Teslimat bekliyor" => "bg-warning text-dark",
            "Geri alım bekliyor" => "bg-warning text-dark",
            "Teslim kaydı eksik" => "bg-danger",
            "Arıza/Bakım" => "bg-danger",
            _ => "bg-secondary"
        };

    private static string GetStatusIcon( CoolingRoomOverviewDto room )
        => GetOperationText( room ) switch
        {
            "Uygun" => "bi-check-circle",
            "Rezerve" => "bi-bookmark-check",
            "Müşteride" => "bi-hourglass-split",
            "Teslimat bekliyor" => "bi-truck",
            "Geri alım bekliyor" => "bi-arrow-return-left",
            "Teslim kaydı eksik" => "bi-exclamation-triangle",
            "Arıza/Bakım" => "bi-exclamation-octagon",
            _ => "bi-info-circle"
        };
}
