@page "/cooling-rooms"
@using DeKayaServer.BlazorApp.Components.Pages.CoolingRoom.CreateCoolingRoom
@using DeKayaServer.BlazorApp.Components.Pages.CoolingRoom.UpdateCoolingRoom
@using DeKayaServer.BlazorApp.Components.Pages.CoolingRoom.DeleteCoolingRoom
@using DeKayaServer.BlazorApp.Components.Pages.CoolingRoom.DetailCoolingRoom
@using DeKayaServer.BlazorApp.Models
@using DeKayaServer.BlazorApp.Services
@using DeKayaServer.Contracts.CoolingRooms
@using DeKayaServer.Contracts.Reservations
@using DeKayaServer.Contracts.Reservations.Enum

@inject ICoolingRoomService coolingRoomService
@inject IApiResultPresenter apiResultPresenter

<PageTitle>De-Kaya Systems | @PageTitleConstans.CoolingRoomPage</PageTitle>

<PageHeader Icon="bi-snow"
            Title="Seyyar Soğuk Odalar"
            Description="Bu sayfa tüm seyyar soğuk odaları listeler."
            ShowBackButton="true" />

<div class="d-flex align-items-end justify-content-between mt-3">
    <div class="small text-body-secondary">
        Toplam: <span class="fw-semibold">@FilteredRooms.Count</span>

        @if ( isLoading )
        {
            <span class="ms-2 spinner-border spinner-border-sm align-middle" role="status" aria-hidden="true"></span>
        }
    </div>

    <button type="button" class="btn btn-outline-success btn-sm" @onclick="ShowCreateCoolingRoomDialog">
        <i class="bi bi-plus-circle"></i>
        <span>Ekle</span>
    </button>
</div>

<div class="card border-1 shadow-sm rounded-4 mt-2 cr-filters">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4 col-lg-3">
                <label class="form-label small text-body-secondary">Arama</label>
                <input class="form-control form-control-sm cr-control"
                       placeholder="Oda, müşteri, rezervasyon..."
                       @bind="searchText"
                       @bind:event="oninput" />
            </div>

            <div class="col-12 col-md-4 col-lg-3">
                <label class="form-label small text-body-secondary">Raf</label>
                <select class="form-select form-select-sm cr-control" @bind="shelfFilter">
                    <option value="@ShelfFilter.All">Tümü</option>
                    <option value="@ShelfFilter.Shelf">Raflı</option>
                    <option value="@ShelfFilter.NoShelf">Rafsız</option>
                </select>
            </div>

            <div class="col-12 col-md-4 col-lg-3">
                <label class="form-label small text-body-secondary">Durum</label>
                <select class="form-select form-select-sm cr-control" @bind="statusFilter">
                    <option value="">Tümü</option>
                    @foreach ( var s in StatusOptions )
                    {
                        <option value="@s">@GetStatusText( s )</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="form-check form-switch cr-switch">
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           id="showInactive"
                           @bind="showInactive" />
                    <label class="form-check-label small px-2" for="showInactive">
                        Pasif odaları göster
                    </label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ClearFilters">
                    Temizle
                </button>

                <button class="btn btn-outline-primary btn-sm" type="button" @onclick="ShowOnlyAvailable">
                    Sadece uygun
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    @foreach ( var room in FilteredRooms )
    {
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card shadow-sm border-1 h-100 rounded-4">
                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge @GetStatusBadgeClass( room ) rounded-pill">
                                <i class="bi @GetStatusIcon( room ) me-1"></i>@GetRoomOperationText( room )
                            </span>

                            @if ( room.Shelf )
                            {
                                <span class="badge text-bg-light border rounded-pill">
                                    <i class="bi bi-inboxes me-1"></i>Raflı Oda
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-light border rounded-pill">
                                    <i class="bi bi-box me-1"></i>Rafsız Oda
                                </span>
                            }

                            @if ( !room.IsActive )
                            {
                                <span class="badge text-bg-secondary rounded-pill">
                                    Pasif
                                </span>
                            }

                            @if ( room.OutstandingAmount > 0 )
                            {
                                <span class="badge text-bg-danger rounded-pill">
                                    Borç var
                                </span>
                            }
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="cp">
                                    <a class="dropdown-item"
                                           @onclick="() => ShowDetailCoolingRoomDialog( room.Id )">
                                        Detay
                                    </a>
                                </li>
                                <li class="cp">
                                    <a class="dropdown-item"
                                           @onclick="() => ShowUpdateCoolingRoomDialog( room.Id )">
                                        Güncelle
                                    </a>
                                </li>
                                <li class="cp"><hr class="dropdown-divider"></li>
                                <li class="cp">
                                    <a class="dropdown-item text-danger"
                                           @onclick="() => ShowDeleteCoolingRoomDialog( room.Id, room.Name )">
                                        Sil
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <div class="fw-semibold">@room.Name</div>
                        <div class="small text-body-secondary mt-1">@FormatMoney( room.DailyPrice ) / gün</div>
                    </div>

                    <div class="d-flex justify-content-center mt-3">
                        <div class="cr-ring" style="--p:@GetProgress( room ); --accent:@GetAccent( room );">
                            <div class="cr-ring__center text-center px-2">
                                @if ( room.Status == CoolingRoomStatus.Available )
                                {
                                    <div class="fw-semibold">Müsait</div>

                                    @if ( room.NextReservationStart is not null )
                                    {
                                        <div class="small text-body-secondary">
                                            Sonraki: @FormatDateTime( room.NextReservationStart.Value )
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-body-secondary">Rezervasyon yok</div>
                                    }
                                }
                                else if ( room.Status == CoolingRoomStatus.Faulty )
                                {
                                    <div class="fw-semibold text-danger">Arıza/Bakım</div>

                                    @if ( room.MaintenanceEnd is not null )
                                    {
                                        <div class="small text-body-secondary">
                                            Bitiş: @FormatDate( room.MaintenanceEnd.Value )
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-body-secondary">Servis kaydı var</div>
                                    }
                                }
                                else if ( room.CurrentReservationEnd is not null )
                                {
                                    <div class="fw-semibold">@GetRoomOperationText( room )</div>
                                    <div class="small text-body-secondary">
                                        Bitiş: @FormatDateTime( room.CurrentReservationEnd.Value )
                                    </div>
                                }
                                else if ( room.NextReservationStart is not null )
                                {
                                    <div class="fw-semibold">@GetRoomOperationText( room )</div>
                                    <div class="small text-body-secondary">
                                        Başlangıç: @FormatDateTime( room.NextReservationStart.Value )
                                    </div>
                                }
                                else
                                {
                                    <div class="fw-semibold">@GetRoomOperationText( room )</div>
                                    <div class="small text-body-secondary">Rezervasyon bilgisi yok</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 small">
                        <div class="d-flex justify-content-between gap-3">
                            <span class="text-body-secondary">Durum</span>
                            <span class="fw-medium text-end">@GetRoomOperationText( room )</span>
                        </div>

                        @if ( !string.IsNullOrWhiteSpace( room.CurrentReservationNumber ) )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Rezervasyon</span>
                                <span class="fw-medium">@room.CurrentReservationNumber</span>
                            </div>
                        }

                        @if ( !string.IsNullOrWhiteSpace( room.CurrentCustomerName ) )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Müşteri</span>
                                <span class="fw-medium text-end">@room.CurrentCustomerName</span>
                            </div>
                        }

                        @if ( !string.IsNullOrWhiteSpace( room.CurrentCustomerPhoneNumber ) )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Telefon</span>
                                <span class="fw-medium">@room.CurrentCustomerPhoneNumber</span>
                            </div>
                        }

                        @if ( room.CurrentReservationEnd is not null )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Rez. Bitiş</span>
                                <span class="fw-medium">@FormatDateTime( room.CurrentReservationEnd.Value )</span>
                            </div>
                        }

                        @if ( room.NextReservationStart is not null )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Sonraki Rez.</span>
                                <span class="fw-medium">@FormatDateTime( room.NextReservationStart.Value )</span>
                            </div>
                        }

                        @if ( room.NextAvailableAt is not null )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Müsaitlik</span>
                                <span class="fw-medium">@FormatDateTime( room.NextAvailableAt.Value )</span>
                            </div>
                        }
                        else if ( room.Status == CoolingRoomStatus.Available )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Müsaitlik</span>
                                <span class="fw-medium text-success">Şimdi</span>
                            </div>
                        }

                        @if ( room.OutstandingAmount > 0 )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Kalan Borç</span>
                                <span class="fw-bold text-danger">@FormatMoney( room.OutstandingAmount )</span>
                            </div>
                        }

                        @if ( !string.IsNullOrWhiteSpace( room.MaintenanceDescription ) )
                        {
                            <div class="d-flex justify-content-between gap-3 mt-2">
                                <span class="text-body-secondary">Bakım</span>
                                <span class="fw-medium text-end">@room.MaintenanceDescription</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between gap-3 mt-2">
                            <span class="text-body-secondary">Günlük Fiyat</span>
                            <span class="fw-medium">@FormatMoney( room.DailyPrice )</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

<CreateCoolingRoomDialog @ref="createCoolingRoomDialog"
                         CoolingRoomAdded="ReloadAsync" />

<UpdateCoolingRoomDialog @ref="updateCoolingRoomDialog"
                         CoolingRoomUpdated="ReloadAsync" />

<DeleteCoolingRoomDialog @ref="deleteCoolingRoomDialog"
                         CoolingRoomDeleted="ReloadAsync" />

<DetailCoolingRoomDialog @ref="detailCoolingRoomDialog"
                         CoolingRoomId="selectedCoolingRoomId" />

@code {
    private CreateCoolingRoomDialog? createCoolingRoomDialog;
    private UpdateCoolingRoomDialog? updateCoolingRoomDialog;
    private DeleteCoolingRoomDialog? deleteCoolingRoomDialog;
    private DetailCoolingRoomDialog? detailCoolingRoomDialog;

    private Guid? selectedCoolingRoomId;
    private bool isLoading;

    private List<CoolingRoomViewModel> rooms = [];

    private string searchText = string.Empty;
    private ShelfFilter shelfFilter = ShelfFilter.All;
    private CoolingRoomStatus? statusFilter = null;
    private bool showInactive = true;

    private static readonly CoolingRoomStatus[] StatusOptions =
    [
        CoolingRoomStatus.Available,
        CoolingRoomStatus.Reserved,
        CoolingRoomStatus.Occupied,
        CoolingRoomStatus.Faulty
    ];

    private List<CoolingRoomViewModel> FilteredRooms
        => rooms
            .Where( r => showInactive || r.IsActive )
            .Where( r => shelfFilter == ShelfFilter.All
                || ( shelfFilter == ShelfFilter.Shelf && r.Shelf )
                || ( shelfFilter == ShelfFilter.NoShelf && !r.Shelf ) )
            .Where( r => statusFilter is null || r.Status == statusFilter.Value )
            .Where( r =>
            {
                var term = searchText.Trim();

                return string.IsNullOrWhiteSpace( term )
                    || r.Name.Contains( term, StringComparison.OrdinalIgnoreCase )
                    || ( r.StatusName != null && r.StatusName.Contains( term, StringComparison.OrdinalIgnoreCase ) )
                    || ( r.CurrentCustomerName != null && r.CurrentCustomerName.Contains( term, StringComparison.OrdinalIgnoreCase ) )
                    || ( r.CurrentCustomerPhoneNumber != null && r.CurrentCustomerPhoneNumber.Contains( term, StringComparison.OrdinalIgnoreCase ) )
                    || ( r.CurrentReservationNumber != null && r.CurrentReservationNumber.Contains( term, StringComparison.OrdinalIgnoreCase ) )
                    || ( r.NextReservationNumber != null && r.NextReservationNumber.Contains( term, StringComparison.OrdinalIgnoreCase ) );
            } )
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        await base.OnInitializedAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            isLoading = true;

            var res = await coolingRoomService.GetOverviewAsync();
            apiResultPresenter.Present( res, new ApiPresentationOptions { ShowSuccess = false } );

            if ( !res.IsSuccessful || res.Data is null )
            {
                rooms = [];
                return;
            }

            rooms = res.Data
                .Select( MapToViewModel )
                .OrderBy( x => x.Name )
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        shelfFilter = ShelfFilter.All;
        statusFilter = null;
        showInactive = true;
    }

    private void ShowOnlyAvailable()
        => statusFilter = CoolingRoomStatus.Available;

    private async Task ShowCreateCoolingRoomDialog()
    {
        if ( createCoolingRoomDialog is null )
        {
            return;
        }

        await createCoolingRoomDialog.ShowAsync();
    }

    private async Task ShowUpdateCoolingRoomDialog( Guid id )
    {
        if ( updateCoolingRoomDialog is null )
        {
            return;
        }

        await updateCoolingRoomDialog.ShowAsync( id );
    }

    private async Task ShowDetailCoolingRoomDialog( Guid id )
    {
        selectedCoolingRoomId = id;

        await InvokeAsync( StateHasChanged );
        await Task.Yield();

        if ( detailCoolingRoomDialog is null )
        {
            return;
        }

        await detailCoolingRoomDialog.ShowAsync();
    }

    private async Task ShowDeleteCoolingRoomDialog( Guid id, string name )
    {
        if ( deleteCoolingRoomDialog is null )
        {
            return;
        }

        await deleteCoolingRoomDialog.ShowAsync( id, name );
    }

    private static CoolingRoomViewModel MapToViewModel( CoolingRoomOverviewDto dto )
        => new()
        {
            Id = dto.Id,
            Name = dto.RoomName,
            DailyPrice = dto.DailyPrice,
            Shelf = dto.Shelf,
            StatusId = dto.StatusId,
            StatusName = dto.StatusName,
            Status = MapStatus( dto.StatusName ),
            MaintenanceId = dto.MaintenanceId,
            IsActive = dto.IsActive,

            CurrentReservationId = dto.CurrentReservationId,
            CurrentReservationNumber = dto.CurrentReservationNumber,
            CurrentCustomerName = dto.CurrentCustomerName,
            CurrentCustomerPhoneNumber = dto.CurrentCustomerPhoneNumber,
            CurrentReservationStart = dto.CurrentReservationStart,
            CurrentReservationEnd = dto.CurrentReservationEnd,
            CurrentReservationStatus = dto.CurrentReservationStatus,
            DeliveredAt = dto.DeliveredAt,
            PickedUpAt = dto.PickedUpAt,

            NextReservationId = dto.NextReservationId,
            NextReservationNumber = dto.NextReservationNumber,
            NextCustomerName = dto.NextCustomerName,
            NextReservationStart = dto.NextReservationStart,
            NextReservationEnd = dto.NextReservationEnd,

            NextAvailableAt = dto.NextAvailableAt,
            OutstandingAmount = dto.OutstandingAmount,

            MaintenanceDescription = dto.MaintenanceDescription,
            MaintenanceEnd = dto.MaintenanceEnd
        };

    private static CoolingRoomStatus MapStatus( string? statusName )
    {
        var key = ( statusName ?? string.Empty ).Trim().ToLowerInvariant();

        return key switch
        {
            "uygun" => CoolingRoomStatus.Available,
            "reserve" or "rezerve" => CoolingRoomStatus.Reserved,
            "booked" => CoolingRoomStatus.Occupied,
            "arıza/bakım" or "ariza/bakim" or "arıza" or "ariza" or "bakım" or "bakim" => CoolingRoomStatus.Faulty,
            _ => CoolingRoomStatus.Available
        };
    }

    private static string GetStatusText( CoolingRoomStatus status )
        => status switch
        {
            CoolingRoomStatus.Available => "Uygun",
            CoolingRoomStatus.Occupied => "Müşteride",
            CoolingRoomStatus.Reserved => "Rezerve",
            CoolingRoomStatus.Faulty => "Arıza/Bakım",
            _ => status.ToString()
        };

    private static string FormatMoney( decimal value )
        => value.ToString( "N2" ) + " ₺";

    private static string FormatDateTime( DateTime value )
        => value.ToString( "dd.MM.yyyy HH:mm" );

    private static string FormatDate( DateTime value )
        => value.ToString( "dd.MM.yyyy" );

    private static string GetRoomOperationText( CoolingRoomViewModel room )
    {
        if ( room.Status == CoolingRoomStatus.Faulty )
        {
            return "Arıza/Bakım";
        }

        if ( room.CurrentReservationStatus == ( int )ReservationOperationStatusDto.DeliveredToCustomer
             && room.CurrentReservationEnd is not null
             && room.CurrentReservationEnd.Value <= DateTime.Now.AddHours( 24 ) )
        {
            return "Geri alım bekliyor";
        }

        if ( room.CurrentReservationStatus == ( int )ReservationOperationStatusDto.DeliveredToCustomer )
        {
            return "Müşteride";
        }

        if ( room.CurrentReservationStatus == ( int )ReservationOperationStatusDto.Scheduled
             && room.CurrentReservationEnd is not null
             && room.CurrentReservationEnd.Value <= DateTime.Now )
        {
            return "Teslim kaydı eksik";
        }

        if ( room.CurrentReservationStatus == ( int )ReservationOperationStatusDto.Scheduled
             && room.CurrentReservationStart is not null
             && room.CurrentReservationStart.Value <= DateTime.Now )
        {
            return "Teslimat bekliyor";
        }

        if ( room.Status == CoolingRoomStatus.Available )
        {
            return "Uygun";
        }

        if ( room.Status == CoolingRoomStatus.Reserved )
        {
            return "Rezerve";
        }

        if ( room.Status == CoolingRoomStatus.Occupied )
        {
            return "Müşteride";
        }

        return !string.IsNullOrWhiteSpace( room.StatusName )
            ? room.StatusName
            : "-";
    }

    private static string GetStatusBadgeClass( CoolingRoomViewModel room )
        => GetRoomOperationText( room ) switch
        {
            "Uygun" => "text-bg-success",
            "Müşteride" => "text-bg-warning",
            "Geri alım bekliyor" => "text-bg-warning",
            "Teslimat bekliyor" => "text-bg-warning",
            "Teslim kaydı eksik" => "text-bg-danger",
            "Arıza/Bakım" => "text-bg-danger",
            "Rezerve" => "text-bg-primary",
            _ => "text-bg-secondary"
        };

    private static string GetStatusIcon( CoolingRoomViewModel room )
        => GetRoomOperationText( room ) switch
        {
            "Uygun" => "bi-check2-circle",
            "Müşteride" => "bi-hourglass-split",
            "Geri alım bekliyor" => "bi-arrow-return-left",
            "Teslimat bekliyor" => "bi-truck",
            "Teslim kaydı eksik" => "bi-exclamation-triangle",
            "Arıza/Bakım" => "bi-exclamation-octagon",
            "Rezerve" => "bi-bookmark-check",
            _ => "bi-info-circle"
        };

    private static int GetProgress( CoolingRoomViewModel room )
    {
        var now = DateTime.Now;

        if ( room.Status == CoolingRoomStatus.Available )
        {
            return 0;
        }

        if ( room.Status == CoolingRoomStatus.Faulty )
        {
            return 100;
        }

        if ( room.CurrentReservationStart is not null
             && room.CurrentReservationEnd is not null
             && room.CurrentReservationStart.Value <= now )
        {
            return GetElapsedReservationProgress(
                room.CurrentReservationStart.Value,
                room.CurrentReservationEnd.Value,
                now );
        }

        if ( room.NextReservationStart is not null )
        {
            return GetUpcomingReservationUrgencyProgress(
                room.NextReservationStart.Value,
                now );
        }

        return 0;
    }

    private static int GetElapsedReservationProgress( DateTime start, DateTime end, DateTime now )
    {
        if ( end <= start )
        {
            return 100;
        }

        if ( now <= start )
        {
            return 0;
        }

        if ( now >= end )
        {
            return 100;
        }

        var total = ( end - start ).TotalSeconds;
        var elapsed = ( now - start ).TotalSeconds;

        return ( int )Math.Clamp( elapsed / total * 100, 0, 100 );
    }

    private static int GetUpcomingReservationUrgencyProgress( DateTime reservationStart, DateTime now )
    {
        var hoursUntilStart = ( reservationStart - now ).TotalHours;

        if ( hoursUntilStart <= 0 )
        {
            return 100;
        }

        if ( hoursUntilStart >= 24 )
        {
            return 20;
        }

        var progress = 100 - ( hoursUntilStart / 24 * 80 );

        return ( int )Math.Clamp( progress, 20, 100 );
    }


    private static string GetAccent( CoolingRoomViewModel room )
    {
        var operationText = GetRoomOperationText( room );

        if ( operationText == "Teslimat bekliyor"
             || operationText == "Geri alım bekliyor" )
        {
            return "#f39c12";
        }

        if ( operationText == "Teslim kaydı eksik" )
        {
            return "#e74c3c";
        }

        return operationText switch
        {
            "Uygun" => "#27ae60",
            "Müşteride" => "#f39c12",
            "Arıza/Bakım" => "#e74c3c",
            "Rezerve" => "#007fff",
            _ => "#22c55e"
        };
    }


    private enum CoolingRoomStatus
    {
        Faulty,
        Available,
        Occupied,
        Reserved,
    }

    private enum ShelfFilter
    {
        All,
        Shelf,
        NoShelf
    }

    private sealed class CoolingRoomViewModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = default!;
        public decimal DailyPrice { get; set; }
        public bool Shelf { get; set; }

        public Guid StatusId { get; set; }
        public string? StatusName { get; set; }
        public Guid? MaintenanceId { get; set; }

        public bool IsActive { get; set; }

        public CoolingRoomStatus Status { get; set; }

        public Guid? CurrentReservationId { get; set; }
        public string? CurrentReservationNumber { get; set; }
        public string? CurrentCustomerName { get; set; }
        public string? CurrentCustomerPhoneNumber { get; set; }
        public DateTime? CurrentReservationStart { get; set; }
        public DateTime? CurrentReservationEnd { get; set; }
        public int? CurrentReservationStatus { get; set; }
        public DateTime? DeliveredAt { get; set; }
        public DateTime? PickedUpAt { get; set; }

        public Guid? NextReservationId { get; set; }
        public string? NextReservationNumber { get; set; }
        public string? NextCustomerName { get; set; }
        public DateTime? NextReservationStart { get; set; }
        public DateTime? NextReservationEnd { get; set; }

        public DateTime? NextAvailableAt { get; set; }
        public decimal OutstandingAmount { get; set; }

        public string? MaintenanceDescription { get; set; }
        public DateTime? MaintenanceEnd { get; set; }
    }
}
